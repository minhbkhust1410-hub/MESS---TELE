{
  "manifest_version": 3,
  "name": "FB EXTEN",
  "short_name": "FB EXTEN",
  "version": "4.3.0",
  "description": "FB EXTEN v4.3 — Hybrid Smart AI (Kết nối trực tiếp Tab Meta AI bộ nhớ sẵn + Groq/Gemini API) chuyên Nhóm AI, Dựng Phim AI, Job AI & Cộng Đồng Trường Học",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Mở FB EXTEN Side Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs",
    "alarms",
    "cookies"
  ],
  "optional_permissions": [
    "debugger"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.messenger.com/*",
    "https://*.meta.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://openrouter.ai/*",
    "http://127.0.0.1:3300/*",
    "http://localhost:3300/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*"
      ],
      "js": [
        "content/graphql-tap.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://*.messenger.com/*"
      ],
      "js": [
        "content/facebook-agent.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.meta.ai/*"
      ],
      "js": [
        "content/meta-ai-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "core-build/**/*.js"
      ],
      "matches": [
        "https://*.facebook.com/*",
        "https://*.messenger.com/*"
      ]
    }
  ]
}
