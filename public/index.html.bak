        footer.innerHTML = `
          <button onclick="inspectAccountProxy('${acc.id}')" class="flex-1 py-2.5 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/30 font-bold text-xs transition flex items-center justify-center gap-1.5">
