                <span class="text-emerald-400 font-bold text-sm bg-emerald-500/10 px-2 py-0.5 rounded-lg border border-emerald-500/20">${res.testResult.ip}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-[#78716C]">📍 Vị trí địa lý / Quốc gia:</span>
                <span class="text-[#D6D3D1]">${res.testResult.country || 'Unknown'} ${res.testResult.city ? `(${res.testResult.city})` : ''}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-[#78716C]">🏢 Nhà mạng (ISP):</span>
