        // TRƯỜNG HỢP 3: TÀI KHOẢN CÓ PROXY NHƯNG PROXY CHẾT / LỖI KẾT NỐI
        badgeContainer.innerHTML = '<span class="px-2.5 py-1 rounded-xl bg-rose-500/15 text-rose-300 border border-rose-500/30 text-[10px] font-mono font-bold flex items-center gap-1"><span>🔴</span> MẤT KẾT NỐI</span>';

        content.innerHTML = `
