              <span class="text-emerald-400 text-lg">🎯</span>
            </div>
            <div class="flex items-baseline gap-2">
              <span id="kpi-autocmt-status" class="text-3xl font-black text-[#FAF7F2]">OFF</span>
              <span id="kpi-groups-count" class="text-xs text-[#A8A29E]">0 Nhóm mục tiêu</span>
            </div>
            <div class="text-[11px] text-emerald-400 mt-2 font-mono">
              Topic 2 · Hậu kiểm DOM xác minh
            </div>
          </div>

        </div>

        <!-- 2 Columns: System Specs & Live Stream -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
          
          <!-- System Specs (7 Cols) -->
          <div class="lg:col-span-7 claude-card rounded-3xl p-6 space-y-5">
            <div class="flex items-center justify-between border-b border-[#2C2723] pb-4">
              <div class="flex items-center gap-2.5">
                <span class="text-base">⚡</span>
                <h3 class="text-xs font-bold uppercase tracking-wider text-[#FAF7F2]">Kiến Trúc Vận Hành Đạt Chuẩn (Roadmap K00 - K62)</h3>
              </div>
              <span class="text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                ACTIVE 24/7
              </span>
            </div>

            <div class="grid grid-cols-2 gap-3.5 text-xs">
              <div class="p-3.5 rounded-2xl bg-[#171412]/80 border border-[#2E2925] space-y-1">
                <span class="text-[#A8A29E] text-[11px]">Cơ chế Đồng Bộ</span>
                <p class="font-bold text-[#FAF7F2] font-mono">MutationObserver Realtime</p>
                <p class="text-[10px] text-emerald-400">Độ trễ tức thì (~0ms) không cần reload</p>
              </div>

              <div class="p-3.5 rounded-2xl bg-[#171412]/80 border border-[#2E2925] space-y-1">
                <span class="text-[#A8A29E] text-[11px]">Mã Hóa E2EE & Thường</span>
                <p class="font-bold text-[#FAF7F2] font-mono">WebCrypto Buffer + DOM</p>
                <p class="text-[10px] text-[#E87A5D]">claimedByThreadId độc quyền (F10)</p>
              </div>

              <div class="p-3.5 rounded-2xl bg-[#171412]/80 border border-[#2E2925] space-y-1">
                <span class="text-[#A8A29E] text-[11px]">Bảo Vệ Đăng Bài (F07)</span>
                <p class="font-bold text-[#FAF7F2] font-mono">Atomic Job Lock</p>
                <p class="text-[10px] text-[#F59E0B]">Chống bấm đúp, chống đăng lặp</p>
              </div>

              <div class="p-3.5 rounded-2xl bg-[#171412]/80 border border-[#2E2925] space-y-1">
                <span class="text-[#A8A29E] text-[11px]">Trình Duyệt Điều Hành</span>
                <p class="font-bold text-[#FAF7F2] font-mono">HEADLESS=false</p>
                <p class="text-[10px] text-stone-300">Cửa sổ Chrome trực quan cho người dùng</p>
              </div>
            </div>

            <!-- 5 Topics Summary Roadmap -->
            <div class="pt-2">
              <span class="text-[11px] font-semibold text-[#A8A29E] uppercase tracking-wider block mb-2.5">5 Phân Hệ Điều Hành Đã Tối Ưu Hóa</span>
              <div class="grid grid-cols-5 gap-2 text-center text-[10px] font-mono">
                <div class="p-2.5 rounded-2xl bg-[#171412] border border-[#2E2925]">
                  <span class="block text-base mb-1">📝</span>
                  <span class="text-[#FAF7F2] font-bold block">Topic 1</span>
                  <span class="text-[#A8A29E]">Đăng bài</span>
                </div>
                <div class="p-2.5 rounded-2xl bg-[#171412] border border-[#2E2925]">
                  <span class="block text-base mb-1">💬</span>
                  <span class="text-[#FAF7F2] font-bold block">Topic 2</span>
                  <span class="text-[#A8A29E]">Bình luận</span>
                </div>
                <div class="p-2.5 rounded-2xl bg-[#171412] border border-[#2E2925]">
                  <span class="block text-base mb-1">👥</span>
                  <span class="text-[#FAF7F2] font-bold block">Topic 3</span>
                  <span class="text-[#A8A29E]">Quét Mem</span>
                </div>
                <div class="p-2.5 rounded-2xl bg-[#171412] border border-[#2E2925]">
                  <span class="block text-base mb-1">🤝</span>
                  <span class="text-[#FAF7F2] font-bold block">Topic 4</span>
                  <span class="text-[#A8A29E]">Kết Bạn</span>
                </div>
                <div class="p-2.5 rounded-2xl bg-[#171412] border border-[#2E2925]">
                  <span class="block text-base mb-1">❤️</span>
                  <span class="text-[#FAF7F2] font-bold block">Topic 5</span>
                  <span class="text-[#A8A29E]">Cảm Xúc</span>
                </div>
