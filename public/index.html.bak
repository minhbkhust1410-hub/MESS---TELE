<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FalconX — Autonomous Stealth Bridge & Facebook Automation</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400;1,6..72,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    /* Typography System */
    body { font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif; }
    .font-serif-claude { font-family: 'Newsreader', serif; }
    .font-mono { font-family: 'JetBrains Mono', monospace; }

    /* Custom Anthropic Terracotta Palette Scrollbar */
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: rgba(20, 18, 16, 0.4); }
    ::-webkit-scrollbar-thumb { background: rgba(87, 83, 78, 0.5); border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(217, 107, 67, 0.7); }

    /* Warm Anthropic Charcoal Surface & GitHub Bento Card Shimmer */
    .claude-card {
      background: rgba(28, 25, 23, 0.7);
      backdrop-filter: blur(24px);
      border: 1px solid rgba(68, 64, 60, 0.45);
      position: relative;
      overflow: hidden;
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease, box-shadow 0.25s ease;
    }
    .claude-card:hover {
      border-color: rgba(217, 107, 67, 0.45);
      box-shadow: 0 14px 40px -12px rgba(217, 107, 67, 0.15);
      transform: translateY(-2px);
    }
    .claude-card::after {
      content: '';
      position: absolute;
      top: 0; left: -140%; width: 70%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.05), transparent);
      transform: skewX(-20deg);
      pointer-events: none;
      transition: none;
    }
    .claude-card:hover::after {
      left: 170%;
      transition: left 0.85s ease-in-out;
    }

    /* Ambient Warm Glow */
    .glow-terracotta {
      box-shadow: 0 0 35px -8px rgba(217, 107, 67, 0.3);
    }
    .glow-amber-subtle {
      box-shadow: 0 0 25px -5px rgba(245, 158, 11, 0.2);
    }

    /* Subtle dot grid pattern */
    .bg-dot-pattern {
      background-image: radial-gradient(rgba(87, 83, 78, 0.2) 1px, transparent 1px);
      background-size: 20px 20px;
    }

    /* GitHub Ambient Aurora Mesh Background */
    .ambient-orb {
      position: absolute;
      border-radius: 9999px;
      filter: blur(120px);
      pointer-events: none;
      mix-blend-mode: screen;
      z-index: 0;
    }
    .orb-terracotta {
      width: 520px; height: 520px;
      background: radial-gradient(circle, rgba(217, 107, 67, 0.22) 0%, transparent 70%);
      top: -120px; left: -100px;
      animation: float-orb-1 18s ease-in-out infinite alternate;
    }
    .orb-purple {
      width: 440px; height: 440px;
      background: radial-gradient(circle, rgba(139, 92, 246, 0.16) 0%, transparent 70%);
      top: 15%; right: -80px;
      animation: float-orb-2 22s ease-in-out infinite alternate;
    }
    .orb-emerald {
      width: 400px; height: 400px;
      background: radial-gradient(circle, rgba(16, 185, 129, 0.15) 0%, transparent 70%);
      bottom: 8%; left: 35%;
      animation: float-orb-3 20s ease-in-out infinite alternate;
    }
    @keyframes float-orb-1 {
      0% { transform: translate(0, 0) scale(1); }
      100% { transform: translate(110px, 90px) scale(1.15); }
    }
    @keyframes float-orb-2 {
      0% { transform: translate(0, 0) scale(1); }
      100% { transform: translate(-100px, 120px) scale(1.1); }
    }
    @keyframes float-orb-3 {
      0% { transform: translate(0, 0) scale(1); }
      100% { transform: translate(80px, -70px) scale(1.12); }
    }

    /* Mascot Animations */
    @keyframes mascot-float {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-7px) rotate(1.5deg); }
    }
    .mascot-container {
      animation: mascot-float 3.6s ease-in-out infinite;
    }
    @keyframes mascot-happy {
      0% { transform: scale(1) translateY(0); }
      25% { transform: scale(1.2, 0.85) translateY(4px); }
      50% { transform: scale(0.9, 1.25) translateY(-18px) rotate(-5deg); }
      75% { transform: scale(1.08, 0.95) translateY(-4px) rotate(3deg); }
      100% { transform: scale(1) translateY(0); }
    }
    .animate-mascot-happy {
      animation: mascot-happy 0.65s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    @keyframes eye-blink {
      0%, 93%, 97%, 100% { transform: scaleY(1); }
      95% { transform: scaleY(0.1); }
    }
    .mascot-eye {
      transform-origin: 50% 48px;
      animation: eye-blink 4.2s infinite ease-in-out;
    }
    @keyframes ear-wiggle-left {
      0%, 86%, 100% { transform: rotate(0deg); }
      90% { transform: rotate(-9deg); }
      94% { transform: rotate(4deg); }
    }
    @keyframes ear-wiggle-right {
      0%, 86%, 100% { transform: rotate(0deg); }
      90% { transform: rotate(9deg); }
      94% { transform: rotate(-4deg); }
    }
    .ear-left {
      transform-origin: 22px 42px;
      animation: ear-wiggle-left 5.2s infinite ease-in-out;
    }
    .ear-right {
      transform-origin: 78px 42px;
      animation: ear-wiggle-right 5.2s infinite ease-in-out;
    }
    @keyframes sparkle-twinkle {
      0%, 100% { opacity: 0.3; transform: scale(0.8) rotate(0deg); }
      50% { opacity: 1; transform: scale(1.25) rotate(180deg); }
    }
    .mascot-sparkle {
      animation: sparkle-twinkle 2.4s ease-in-out infinite;
    }

    @keyframes pulse-warm {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.6; transform: scale(0.95); }
    }
    .animate-warm-pulse { animation: pulse-warm 2.2s infinite ease-in-out; }

    /* GitHub Live Heartbeat Cells */
    @keyframes matrix-cell-pulse {
      0%, 100% { opacity: 0.55; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.15); filter: drop-shadow(0 0 3px rgba(16, 185, 129, 0.8)); }
    }
    .matrix-live-cell {
      animation: matrix-cell-pulse 3s infinite ease-in-out;
    }
  </style>
</head>
<body class="bg-[#12100E] text-[#F5F2EB] min-h-screen flex selection:bg-[#D96B43] selection:text-white bg-dot-pattern relative">

  <!-- GitHub-Style Ambient Aurora Glow Orbs -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true">
    <div class="ambient-orb orb-terracotta"></div>
    <div class="ambient-orb orb-purple"></div>
    <div class="ambient-orb orb-emerald"></div>
  </div>

  <!-- Cute Interactive Canvas for Confetti -->
  <canvas id="cute-confetti-canvas" class="fixed inset-0 pointer-events-none z-50"></canvas>

  <!-- ======================================================== -->
  <!-- 1. LEFT SIDEBAR (Anthropic Human-Crafted Aesthetic)       -->
  <!-- ======================================================== -->
  <aside class="w-68 bg-[#171412]/95 border-r border-[#2C2723] flex flex-col justify-between p-5 sticky top-0 h-screen z-40 hidden md:flex backdrop-blur-xl">
    
    <!-- Top Branding & Navigation -->
    <div class="space-y-6">
      
      <!-- Brand Logo with FalconX Falcon Wing / SpaceX Aerodynamic Motif -->
      <div class="flex items-center gap-3 px-1 py-1">
        <div onclick="triggerCuteConfetti(event)" title="FalconX — Lấy cảm hứng từ Falcon Wing & SpaceX! Nhấp để bắn pháo hoa ✨" class="w-9 h-9 rounded-2xl bg-gradient-to-tr from-[#D96B43] via-[#E27D56] to-[#F59E0B] flex items-center justify-center text-white text-base font-black shadow-lg shadow-[#D96B43]/25 cursor-pointer hover:scale-110 active:scale-95 transition-transform duration-200 group">
          <svg class="w-5 h-5 fill-current transform group-hover:rotate-12 transition-transform duration-200" viewBox="0 0 24 24">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="text-base font-extrabold tracking-tight text-[#FAF7F2] font-mono">Falcon<span class="text-[#D96B43]">X</span></span>
            <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded-full bg-[#D96B43]/20 text-[#E87A5D] border border-[#D96B43]/30">v2.0</span>
          </div>
          <p class="text-[9px] text-[#A8A29E] tracking-wider uppercase font-mono">Autonomous Stealth Bridge</p>
        </div>
      </div>

      <!-- Active Profile Mini Card (Warm Stone Surface) -->
      <div class="p-3.5 rounded-2xl bg-[#1F1B18]/90 border border-[#38332E] relative overflow-hidden group space-y-2.5">
        <div class="absolute top-0 right-0 w-24 h-24 bg-[#D96B43]/5 rounded-full blur-xl pointer-events-none"></div>
        <div class="flex items-center gap-3">
          <div class="relative cursor-pointer group/avatar" onclick="openAvatarModal()" title="Nhấp để xem/đổi/đồng bộ ảnh đại diện">
            <img id="sidebar-avatar" src="https://graph.facebook.com/61577949601039/picture?type=large" class="w-11 h-11 rounded-xl object-cover border border-[#44403C] shadow flex-shrink-0 group-hover/avatar:border-[#D96B43] transition" />
            <div class="absolute inset-0 bg-black/40 rounded-xl opacity-0 group-hover/avatar:opacity-100 flex items-center justify-center transition text-xs text-white">
              📸
            </div>
            <button onclick="syncAvatarNow(event)" title="Đồng bộ avatar từ Facebook" class="absolute -bottom-1 -right-1 w-4 h-4 bg-[#D96B43] hover:bg-[#E27D56] rounded-full text-[9px] flex items-center justify-center text-white border border-[#1F1B18] shadow transition">
              🔄
            </button>
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex items-center justify-between">
              <button onclick="openSidebarActiveProfilePage()" class="text-xs font-bold text-[#F5F2EB] hover:text-[#4599FF] transition truncate flex items-center gap-1 text-left" title="Mở trang cá nhân Facebook qua Proxy an toàn">
                <span id="sidebar-name">Eco Trang</span>
                <span class="text-[10px] text-[#4599FF]">↗</span>
              </button>
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-warm-pulse flex-shrink-0" title="Phiên hoạt động live"></span>
            </div>
            <span id="sidebar-uid" class="text-[10px] text-[#A8A29E] font-mono block truncate">UID: 61577949601039</span>
            <div class="flex items-center justify-between mt-0.5">
              <span class="text-[9px] text-[#E87A5D] font-mono font-bold flex items-center gap-1">
                <span>●</span> Phiên Facebook LIVE
              </span>
            </div>
          </div>
        </div>

        <!-- Live Proxy Status Pill in Sidebar -->
        <div id="sidebar-proxy-pill" onclick="checkSidebarProxyModal()" 
             class="flex items-center justify-between text-[10px] font-mono py-1 px-2.5 rounded-xl bg-[#141210] border border-[#2E2925] cursor-pointer hover:border-[#D96B43]/50 transition group/proxy"
             title="Nhấp để kiểm tra chi tiết Proxy & ràng buộc bảo vệ">
          <span id="sidebar-proxy-status-tag" class="flex items-center gap-1.5 text-[#A8A29E] truncate">
            <span>🛡️</span> <span id="sidebar-proxy-brief">Đang kiểm tra...</span>
          </span>
          <span class="text-[9px] text-[#D96B43] font-bold group-hover/proxy:underline flex-shrink-0">Check ↗</span>
        </div>

        <!-- Direct Button to Facebook & Check Proxy -->
        <div class="pt-2 border-t border-[#2E2925] flex items-center gap-1.5">
          <button id="sidebar-fb-btn" onclick="openSidebarActiveAccountBrowser()" 
                  class="flex-1 py-1.5 px-2 rounded-xl bg-[#1877F2]/15 hover:bg-[#1877F2]/25 text-[#4599FF] border border-[#1877F2]/30 text-[11px] font-bold flex items-center justify-center gap-1.5 transition shadow-sm group"
                  title="Mở Facebook được bọc sẵn Proxy an toàn 100% (Tuyệt đối không lộ IP máy)">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            <span>Vào FB (Proxy) ↗</span>
          </button>
          <button onclick="checkSidebarProxyModal()" 
                  class="py-1.5 px-2.5 rounded-xl bg-amber-500/15 hover:bg-amber-500/25 text-amber-300 border border-amber-500/30 text-[11px] font-bold flex items-center justify-center gap-1 transition shadow-sm"
                  title="Kiểm tra trạng thái, IP & ràng buộc Proxy của nick">
            <span>⚡ Check Proxy</span>
          </button>
          <button onclick="openAvatarModal()" title="Cập nhật ảnh đại diện nick này" class="p-1.5 px-2 rounded-xl bg-[#28231F] hover:bg-[#342E29] text-[#D6D3D1] border border-[#3E3832] text-xs transition flex items-center gap-1">
            <span>📸</span>
          </button>
        </div>
      </div>

      <!-- Navigation Menu Items -->
      <nav class="space-y-1">
        
        <button onclick="switchTab('overview')" id="nav-btn-overview" class="nav-item w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition bg-[#D96B43]/15 text-[#FAF7F2] border border-[#D96B43]/30 shadow-sm">
          <div class="flex items-center gap-2.5">
            <span class="text-sm">📊</span>
            <span>Tổng Quan Hệ Thống</span>
          </div>
        </button>

        <button onclick="switchTab('inbox')" id="nav-btn-inbox" class="nav-item w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition text-[#A8A29E] hover:text-[#FAF7F2] hover:bg-[#24201C]">
          <div class="flex items-center gap-2.5">
            <span class="text-sm">💬</span>
            <span>Hội Thoại Khách Hàng</span>
          </div>
          <span id="sidebar-badge-customers" class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-[#2A2420] text-[#D6D3D1] font-bold">22</span>
        </button>

        <button onclick="switchTab('posts')" id="nav-btn-posts" class="nav-item w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition text-[#A8A29E] hover:text-[#FAF7F2] hover:bg-[#24201C]">
          <div class="flex items-center gap-2.5">
            <span class="text-sm">📝</span>
            <span>Topic 1: Đăng Bài & Lịch</span>
          </div>
          <span id="sidebar-badge-posts" class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-[#2A2420] text-[#D6D3D1] font-bold">0</span>
        </button>

        <button onclick="switchTab('autocmt')" id="nav-btn-autocmt" class="nav-item w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition text-[#A8A29E] hover:text-[#FAF7F2] hover:bg-[#24201C]">
          <div class="flex items-center gap-2.5">
            <span class="text-sm">🎯</span>
            <span>Topic 2: Cmt & Quét Bài</span>
          </div>
        </button>

        <button onclick="switchTab('growth')" id="nav-btn-growth" class="nav-item w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition text-[#A8A29E] hover:text-[#FAF7F2] hover:bg-[#24201C]">
          <div class="flex items-center gap-2.5">
            <span class="text-sm">👥</span>
            <span>Topic 3-5: Tương Tác & Mem</span>
          </div>
        </button>

        <button onclick="switchTab('accounts')" id="nav-btn-accounts" class="nav-item w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition text-[#A8A29E] hover:text-[#FAF7F2] hover:bg-[#24201C]">
          <div class="flex items-center gap-2.5">
            <span class="text-sm">🛡️</span>
            <span>Hồ Sơ Nick & Proxy</span>
          </div>
        </button>

        <button onclick="switchTab('logs')" id="nav-btn-logs" class="nav-item w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition text-[#A8A29E] hover:text-[#FAF7F2] hover:bg-[#24201C]">
          <div class="flex items-center gap-2.5">
            <span class="text-sm">💻</span>
            <span>Console & Nhật Ký Live</span>
          </div>
        </button>

      </nav>

    </div>

    <!-- Sidebar Bottom Info Panel -->
    <div class="p-3.5 rounded-2xl bg-[#1C1815]/90 border border-[#38332E] space-y-2.5">
      <div class="flex items-center justify-between text-xs">
        <span class="text-[#A8A29E]">Telegram Bot</span>
        <span class="text-[#E87A5D] font-mono font-bold text-[11px]" id="sidebar-bot-tag">@ecotrang_mess_bot</span>
      </div>
      <div class="flex items-center justify-between text-xs">
        <span class="text-[#A8A29E]">Uptime Hệ Thống</span>
        <span class="text-emerald-400 font-mono font-bold text-[11px]" id="sidebar-uptime">--:--</span>
      </div>
      <a href="https://web.telegram.org" target="_blank" class="w-full mt-1 py-2 px-3 rounded-xl bg-[#D96B43]/15 hover:bg-[#D96B43]/25 text-[#E87A5D] border border-[#D96B43]/30 text-xs font-bold flex items-center justify-center gap-2 transition">
        <span>✈️</span> Mở Nhóm Telegram
      </a>
    </div>

  </aside>

  <!-- ======================================================== -->
  <!-- 2. MAIN WORKSPACE CANVAS                                 -->
  <!-- ======================================================== -->
  <div class="flex-1 flex flex-col min-w-0">
    
    <!-- Top Warm Header Bar -->
    <header class="h-16 border-b border-[#2C2723] bg-[#14110F]/90 backdrop-blur-xl px-7 flex items-center justify-between sticky top-0 z-30">
      
      <!-- Current Section Title with Elegant Serif Touch -->
      <div class="flex items-center gap-3">
        <h2 id="section-title" class="text-base font-bold text-[#FAF7F2] flex items-center gap-2">
          <span>📊</span>
          <span class="tracking-tight">Tổng Quan Bảng Điều Khiển</span>
        </h2>
        <span class="h-4 w-[1px] bg-[#38332E] hidden sm:block"></span>
        <span class="text-xs text-[#A8A29E] hidden sm:inline font-sans" id="section-desc">Giám sát tiến trình thời gian thực và đồng bộ 2 chiều</span>
      </div>

      <!-- Action Buttons (Pill Shapes & Warm Accents) -->
      <div class="flex items-center gap-2.5">

        <button id="header-fb-btn" onclick="openSidebarActiveAccountBrowser()" class="px-3.5 py-1.5 rounded-xl bg-[#1877F2]/15 hover:bg-[#1877F2]/25 border border-[#1877F2]/30 text-xs font-semibold text-[#4599FF] transition flex items-center gap-1.5 shadow-sm active:scale-95 duration-150" title="Mở Facebook được bọc sẵn Proxy an toàn 100%">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          <span class="hidden sm:inline">Vào FB (Proxy) ↗</span>
        </button>
        
        <button onclick="viewScreenModal()" class="px-3.5 py-1.5 rounded-xl bg-[#24201C] hover:bg-[#2C2723] border border-[#3E3832] text-xs font-semibold text-[#E7E5E4] transition flex items-center gap-2 active:scale-95 duration-150">
          <span>🖥️</span>
          <span class="hidden sm:inline">Màn hình FB</span>
        </button>

        <button onclick="openAddAccountModal()" class="px-4 py-1.5 rounded-xl bg-[#D96B43] hover:bg-[#E27D56] text-xs font-bold text-white shadow-md shadow-[#D96B43]/25 transition flex items-center gap-1.5 active:scale-95 duration-150">
          <span>➕</span>
          <span>Thêm Nick</span>
        </button>

        <button onclick="refreshData()" class="p-2 rounded-xl bg-[#24201C] hover:bg-[#2C2723] border border-[#3E3832] text-[#D6D3D1] transition active:scale-95 duration-150" title="Làm mới dữ liệu">
          <span id="refresh-icon" class="inline-block text-xs">🔄</span>
        </button>

      </div>
    </header>

    <!-- Main Dynamic Content Container -->
    <main class="flex-1 p-7 space-y-7 max-w-7xl w-full mx-auto">
      
      <!-- ======================================================== -->
      <!-- TAB 1: TỔNG QUAN HỆ THỐNG (OVERVIEW)                     -->
      <!-- ======================================================== -->
      <div id="tab-overview" class="space-y-7 tab-content">
        
        <!-- Hero Banner with Claude Warm Aesthetic & GitHub Heartbeat -->
        <div class="claude-card rounded-3xl p-6 sm:p-7 relative overflow-hidden border border-[#38332E]">
          <div class="absolute -top-16 -right-16 w-56 h-56 bg-gradient-to-br from-[#D96B43]/15 via-[#F59E0B]/10 to-transparent rounded-full blur-3xl pointer-events-none"></div>
          <div class="relative z-10 max-w-3xl space-y-2">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#D96B43]/15 text-[#E87A5D] border border-[#D96B43]/30 text-xs font-mono font-semibold">
              <span class="w-1.5 h-1.5 rounded-full bg-[#D96B43] animate-warm-pulse"></span>
              FALCONX AUTONOMOUS PROTOCOL
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold font-serif-claude tracking-tight text-[#FAF7F2]">
              Hệ thống Điều hành Facebook <span class="text-[#E87A5D] italic">thông minh & cá tính</span> từ Telegram.
            </h1>
            <p class="text-xs sm:text-sm text-[#A8A29E] leading-relaxed">
              Cầu nối 2 chiều tức thì, giải mã E2EE WebCrypto, bảo vệ phiên đăng nhập độc lập và phân phối bài viết an toàn qua 5 Topic chuyên biệt.
            </p>

            <!-- GitHub-Style Heartbeat Activity Matrix -->
            <div class="flex items-center justify-between flex-wrap gap-3 pt-3 border-t border-[#38332E]/60 text-xs mt-3">
              <div class="flex items-center gap-2">
                <span class="text-xs">💓</span>
                <span class="text-[#FAF7F2] font-semibold text-[11px] font-mono">Falcon Pulse:</span>
                <div class="flex items-center gap-1" id="github-matrix-cells" title="Nhịp đập hệ thống thời gian thực">
                  <span class="w-2.5 h-2.5 rounded-sm bg-emerald-500/80 matrix-live-cell inline-block" title="Proxy Tunnel: 100% OK"></span>
                  <span class="w-2.5 h-2.5 rounded-sm bg-emerald-500/90 matrix-live-cell inline-block" style="animation-delay: 0.2s" title="Anti-Leak WebRTC: 100% Active"></span>
                  <span class="w-2.5 h-2.5 rounded-sm bg-emerald-500 matrix-live-cell inline-block" style="animation-delay: 0.4s" title="Messenger MutationObserver: LIVE"></span>
                  <span class="w-2.5 h-2.5 rounded-sm bg-emerald-400 matrix-live-cell inline-block" style="animation-delay: 0.6s" title="Telegram Bot Sync: Connected"></span>
                  <span class="w-2.5 h-2.5 rounded-sm bg-emerald-500/70 matrix-live-cell inline-block" style="animation-delay: 0.8s" title="Auto-Bypass PIN: Ready"></span>
                  <span class="w-2.5 h-2.5 rounded-sm bg-[#D96B43] matrix-live-cell inline-block" style="animation-delay: 1.0s" title="Global Lead Pool: Shared"></span>
                  <span class="w-2.5 h-2.5 rounded-sm bg-emerald-500 matrix-live-cell inline-block" style="animation-delay: 1.2s" title="Stealth Chromium: Active"></span>
                  <span class="w-2.5 h-2.5 rounded-sm bg-emerald-400 matrix-live-cell inline-block" style="animation-delay: 1.4s" title="SQLite Store: Synced"></span>
                </div>
              </div>
              <div class="flex items-center gap-2 font-mono text-[10px] text-[#A8A29E]">
                <span class="flex items-center gap-1 text-emerald-400">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                  0 Leak Alert
                </span>
                <span>•</span>
                <span class="text-[#D96B43]">Proxy Strict Guard: ON</span>
                <span>•</span>
                <button onclick="triggerCuteConfetti(event)" class="hover:text-amber-300 transition cursor-pointer flex items-center gap-1 text-[#E87A5D]" title="Nhấp để bắn pháo hoa dễ thương!">
                  <span>✨ Thả Tim</span>
                </button>
              </div>
            </div>
          </div>
