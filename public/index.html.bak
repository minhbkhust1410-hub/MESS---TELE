            </div>

          </div>

          <!-- Live Activity Feed Stream (5 Cols) -->
          <div class="lg:col-span-5 claude-card rounded-3xl p-6 space-y-4 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between border-b border-[#2C2723] pb-4 mb-4">
                <div class="flex items-center gap-2.5">
                  <span class="text-base">📡</span>
                  <h3 class="text-xs font-bold uppercase tracking-wider text-[#FAF7F2]">Luồng Sự Kiện Trực Tiếp</h3>
                </div>
                <span class="text-[10px] font-mono text-[#A8A29E]">Live Stream</span>
              </div>
              <div id="live-activity-stream" class="space-y-2.5 max-h-72 overflow-y-auto pr-1 text-[11px] font-mono custom-scroll">
                <div class="p-2.5 rounded-xl bg-[#171412]/60 border border-[#2E2925] text-[#D6D3D1]">
                  <span class="text-[#8C847E]">[Khởi động]</span> Hệ thống FalconX Autonomous Bridge sẵn sàng đồng bộ 2 chiều.
                </div>
              </div>
            </div>
            <button onclick="switchTab('logs')" class="w-full mt-4 py-2.5 px-4 rounded-xl bg-[#24201C] hover:bg-[#2C2723] text-[#FAF7F2] border border-[#3E3832] text-xs font-semibold transition text-center">
              Mở toàn bộ Console Terminal ↗
            </button>
          </div>

        </div>

      </div>

      <!-- ======================================================== -->
      <!-- TAB 2: HỘI THOẠI KHÁCH HÀNG (INBOX / CHAT BRIDGE)         -->
      <!-- ======================================================== -->
      <div id="tab-inbox" class="space-y-5 tab-content hidden">
        
        <!-- Filter and Search Header -->
        <div class="claude-card rounded-3xl p-5 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="flex items-center gap-3 w-full sm:w-auto">
            <div class="relative flex-1 sm:w-80">
              <input type="text" id="cust-filter-input" oninput="filterCustomerList()" placeholder="🔍 Tìm theo tên khách, UID hoặc Topic ID..." class="w-full bg-[#171412] border border-[#38332E] rounded-2xl px-4 py-2.5 text-xs text-[#FAF7F2] placeholder-[#78716C] focus:outline-none focus:border-[#D96B43] font-sans" />
            </div>
            <span class="text-xs text-[#A8A29E] font-mono whitespace-nowrap"><span id="cust-count-badge" class="font-bold text-[#FAF7F2]">22</span> khách hàng</span>
          </div>

          <div class="flex items-center gap-2 text-xs font-mono">
            <span class="text-[#A8A29E]">Nhãn phân loại:</span>
            <span class="px-2.5 py-1 rounded-lg bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 text-[10px]">🏷️ ĐÃ CHỐT</span>
            <span class="px-2.5 py-1 rounded-lg bg-amber-500/15 text-amber-300 border border-amber-500/30 text-[10px]">⏳ HỎI GIÁ</span>
            <span class="px-2.5 py-1 rounded-lg bg-purple-500/15 text-purple-300 border border-purple-500/30 text-[10px]">⭐ VIP</span>
          </div>
        </div>

        <!-- Customer Cards Grid -->
        <div id="customers-cards-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <!-- Dynamically populated -->
        </div>

      </div>

      <!-- ======================================================== -->
      <!-- TAB 3: ĐĂNG BÀI & PHÂN PHỐI (POSTS / TOPIC 1)            -->
      <!-- ======================================================== -->
      <div id="tab-posts" class="space-y-6 tab-content hidden">
        
        <!-- BẢNG SOẠN & ĐĂNG BÀI TRỰC TIẾP LÊN FACEBOOK -->
        <div class="claude-card rounded-3xl p-6 space-y-5 border border-[#3E3832] bg-[#1E1A17]">
          <div class="flex items-center justify-between border-b border-[#2C2723] pb-4">
            <div class="flex items-center gap-3">
              <span class="text-2xl">📝</span>
              <div>
                <h3 class="text-sm font-bold text-[#FAF7F2] tracking-tight">Soạn & Đăng Bài Trực Tiếp Lên Facebook</h3>
                <p class="text-[11px] text-[#A8A29E]">Đăng bài tức thì hoặc lên lịch phân phối song song cùng Telegram Topic 1</p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[10px] font-mono px-3 py-1 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 font-bold flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                <span>Nick: Eco Trang • Sẵn sàng</span>
              </span>
            </div>
          </div>

          <!-- Nội dung bài viết -->
          <div class="space-y-2">
            <div class="flex items-center justify-between text-xs">
              <label class="font-bold text-[#D6D3D1] flex items-center gap-1.5">
                <span>💬 Nội Dung Bài Viết</span>
                <span class="text-[#E87A5D]">*</span>
              </label>
              <span id="post-char-count" class="text-[11px] font-mono text-[#A8A29E]">0 ký tự</span>
            </div>
            <textarea id="web-post-content" rows="4" oninput="updatePostCharCount()"
              placeholder="Nhập nội dung bài đăng Facebook (VD: 🏠 BÁN CĂN HỘ ECOPARK... Hotline: 0988...)"
              class="w-full rounded-2xl bg-[#141210] border border-[#2E2925] p-4 text-xs font-sans text-[#FAF7F2] focus:border-[#D96B43] focus:outline-none placeholder-[#78716C] leading-relaxed transition"></textarea>
          </div>

          <!-- Chọn Đích Đến (Trang cá nhân / Group / Cả hai) -->
          <div class="space-y-2.5">
            <label class="text-xs font-bold text-[#D6D3D1] block">🎯 Chọn Nơi Đăng Bài:</label>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
              <label class="flex items-center gap-2.5 p-3 rounded-2xl bg-[#141210] border border-[#2E2925] hover:border-[#D96B43]/50 cursor-pointer transition">
                <input type="radio" name="web-post-target" value="personal_post" checked onchange="toggleGroupSelectionUI()" class="accent-[#D96B43]" />
                <div>
                  <div class="font-bold text-[#FAF7F2]">👤 Trang Cá Nhân</div>
                  <div class="text-[10px] text-[#A8A29E]">Đăng lên tường Eco Trang</div>
                </div>
              </label>

              <label class="flex items-center gap-2.5 p-3 rounded-2xl bg-[#141210] border border-[#2E2925] hover:border-[#D96B43]/50 cursor-pointer transition">
                <input type="radio" name="web-post-target" value="group_post" onchange="toggleGroupSelectionUI()" class="accent-[#D96B43]" />
                <div>
                  <div class="font-bold text-[#FAF7F2]">🌐 Nhóm Mục Tiêu</div>
                  <div class="text-[10px] text-[#A8A29E]">Đăng vào các Group đã chọn</div>
                </div>
              </label>

              <label class="flex items-center gap-2.5 p-3 rounded-2xl bg-[#141210] border border-[#2E2925] hover:border-[#D96B43]/50 cursor-pointer transition">
                <input type="radio" name="web-post-target" value="both" onchange="toggleGroupSelectionUI()" class="accent-[#D96B43]" />
                <div>
                  <div class="font-bold text-[#FAF7F2]">⚡ Cả Cá Nhân & Group</div>
                  <div class="text-[10px] text-[#A8A29E]">Phủ sóng tối đa 2 chiều</div>
                </div>
              </label>
            </div>

            <!-- Danh sách checkbox Group (ẩn khi chỉ chọn cá nhân) -->
            <div id="web-post-groups-panel" class="hidden p-4 rounded-2xl bg-[#141210] border border-[#2E2925] space-y-2.5">
              <div class="flex items-center justify-between text-xs">
                <span class="font-bold text-[#FAF7F2]">Chọn Group cần đăng:</span>
                <button type="button" onclick="toggleSelectAllPostGroups()" class="text-[11px] text-[#D96B43] hover:underline font-semibold">Tích chọn tất cả</button>
              </div>
              <div id="web-post-groups-checkboxes" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                <!-- Dynamically loaded from groups list -->
              </div>
            </div>
          </div>

          <!-- Đính kèm hình ảnh -->
          <div class="space-y-2">
            <label class="text-xs font-bold text-[#D6D3D1] block">📸 Hình Ảnh Đính Kèm (Tùy chọn):</label>
            <div class="flex items-center gap-3">
              <input type="file" id="web-post-file-input" multiple accept="image/*" onchange="handlePostFilesSelect(event)" class="hidden" />
              <button type="button" onclick="document.getElementById('web-post-file-input').click()"
                class="px-4 py-2 rounded-xl bg-[#24201C] hover:bg-[#2C2723] text-[#FAF7F2] border border-[#3E3832] text-xs font-semibold flex items-center gap-2 transition">
                <span>📁 Chọn File Ảnh Từ Máy</span>
              </button>
              <span id="web-post-files-summary" class="text-xs text-[#A8A29E] font-mono">Chưa chọn ảnh</span>
            </div>
            <div id="web-post-previews-container" class="flex flex-wrap gap-2.5 pt-1"></div>
          </div>

          <!-- Các nút hành động chính -->
          <div class="flex flex-wrap items-center justify-between gap-3 pt-2 border-t border-[#2C2723]">
            <div class="flex items-center gap-2">
              <button id="btn-web-publish-now" onclick="publishPostDirectFromWeb()"
                class="px-5 py-2.5 rounded-xl bg-[#D96B43] hover:bg-[#E27D56] text-white text-xs font-bold transition shadow-lg shadow-[#D96B43]/30 flex items-center gap-2">
                <span>⚡ ĐĂNG NGAY LÊN FACEBOOK</span>
              </button>
              
              <button onclick="schedulePostFromWeb()"
                class="px-4 py-2.5 rounded-xl bg-[#24201C] hover:bg-[#2C2723] text-[#FAF7F2] border border-[#3E3832] text-xs font-semibold flex items-center gap-2 transition">
                <span>⏰ Lên Lịch / Thêm Hàng Đợi</span>
              </button>
            </div>

            <button onclick="clearPostComposerForm()" class="text-xs text-[#A8A29E] hover:text-[#FAF7F2] transition">
              Làm mới form
            </button>
          </div>

          <!-- Khung hiển thị kết quả & Ảnh Proof sau khi đăng -->
          <div id="web-post-result-panel" class="hidden p-4 rounded-2xl bg-[#141210] border border-emerald-500/30 space-y-3">
            <div class="flex items-center justify-between">
              <span id="web-post-result-title" class="text-xs font-bold text-emerald-400">🎉 ĐÃ ĐĂNG BÀI THÀNH CÔNG!</span>
              <span id="web-post-result-time" class="text-[11px] font-mono text-[#A8A29E]"></span>
            </div>
            <p id="web-post-result-desc" class="text-xs text-[#FAF7F2] leading-relaxed"></p>
            <div id="web-post-proof-container" class="rounded-xl overflow-hidden border border-[#2E2925] max-h-80 bg-black flex items-center justify-center">
              <img id="web-post-proof-img" src="" class="max-h-80 object-contain" />
            </div>
          </div>
        </div>

        <!-- ======================================================== -->
        <!-- MODULE: QUẢN LÝ KHO GROUP & TRẠNG THÁI KHẢ DỤNG ĐĂNG BÀI -->
        <!-- ======================================================== -->
        <div class="claude-card rounded-3xl p-6 space-y-5 border border-[#3E3832] bg-[#1E1A17]">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[#2C2723] pb-4">
            <div class="flex items-center gap-3">
              <span class="text-2xl">🏛️</span>
              <div>
                <h3 class="text-sm font-bold text-[#FAF7F2] tracking-tight flex items-center gap-2">
                  <span>Kho Group Mục Tiêu & Trạng Thái Đăng Bài</span>
                  <span class="text-[10px] px-2 py-0.5 rounded-full bg-[#D96B43]/20 text-[#E87A5D] border border-[#D96B43]/30 font-mono font-bold">Auto-Notes</span>
                </h3>
                <p class="text-[11px] text-[#A8A29E]">Tự động ghi chú các nhóm thường lỗi hoặc chờ duyệt, phân loại nhóm đăng trực tiếp và quản lý dạng bài đăng.</p>
              </div>
            </div>
            <div class="flex items-center gap-2 flex-wrap">
              <button onclick="syncJoinedGroups()" class="text-xs px-3 py-1.5 rounded-xl bg-[#24201C] hover:bg-[#2C2723] text-[#FAF7F2] border border-[#3E3832] font-semibold transition flex items-center gap-1.5" title="Đồng bộ các Group đã tham gia thực tế trên Facebook">
                <span>🔄 Đồng Bộ Group Đã Tham Gia</span>
              </button>
              <button onclick="openAddNewGroupModal()" class="text-xs px-3 py-1.5 rounded-xl bg-[#D96B43] hover:bg-[#E27D56] text-white font-bold transition flex items-center gap-1.5 shadow">
                <span>➕ Thêm Group Mới</span>
              </button>
            </div>
          </div>

          <!-- KPI THỐNG KÊ NHANH TÌNH TRẠNG KHO GROUP -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="p-3.5 rounded-2xl bg-[#141210] border border-[#2E2925] flex items-center justify-between">
              <div>
                <div class="text-[10px] font-mono text-[#A8A29E] uppercase">Tổng Group Trong Kho</div>
                <div id="group-stat-total" class="text-lg font-bold font-mono text-[#FAF7F2] mt-0.5">0</div>
              </div>
              <span class="text-2xl opacity-70">📁</span>
            </div>

            <div class="p-3.5 rounded-2xl bg-[#141210] border border-emerald-500/20 flex items-center justify-between">
              <div>
                <div class="text-[10px] font-mono text-emerald-400 uppercase">Đăng Ngay Trực Tiếp</div>
                <div id="group-stat-direct" class="text-lg font-bold font-mono text-emerald-400 mt-0.5">0</div>
              </div>
              <span class="text-2xl">🟢</span>
            </div>

            <div class="p-3.5 rounded-2xl bg-[#141210] border border-amber-500/20 flex items-center justify-between">
              <div>
                <div class="text-[10px] font-mono text-amber-400 uppercase">Cần Admin Duyệt</div>
                <div id="group-stat-pending" class="text-lg font-bold font-mono text-amber-400 mt-0.5">0</div>
              </div>
              <span class="text-2xl">⏳</span>
            </div>

            <div class="p-3.5 rounded-2xl bg-[#141210] border border-rose-500/20 flex items-center justify-between">
              <div>
                <div class="text-[10px] font-mono text-rose-400 uppercase">Thường Lỗi / Bị Chặn</div>
                <div id="group-stat-failed" class="text-lg font-bold font-mono text-rose-400 mt-0.5">0</div>
              </div>
              <span class="text-2xl">🔴</span>
            </div>
          </div>

          <!-- BẢNG THEO DÕI & NOTE TỪNG GROUP -->
          <div class="space-y-3">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <span class="text-xs font-bold text-[#FAF7F2] uppercase tracking-wider block">Danh Sách Nhóm & Ghi Chú Đặc Thù:</span>
              <div class="flex items-center gap-1.5 flex-wrap">
                <button onclick="filterGroupHealthTable('all')" class="group-filter-btn px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-[#24201C] text-[#FAF7F2] border border-[#3E3832]" id="btn-grp-filter-all">Tất cả</button>
                <button onclick="filterGroupHealthTable('direct')" class="group-filter-btn px-2.5 py-1 rounded-lg text-[11px] font-semibold text-[#A8A29E] hover:text-[#FAF7F2]" id="btn-grp-filter-direct">🟢 Đăng tốt</button>
                <button onclick="filterGroupHealthTable('pending')" class="group-filter-btn px-2.5 py-1 rounded-lg text-[11px] font-semibold text-[#A8A29E] hover:text-[#FAF7F2]" id="btn-grp-filter-pending">⏳ Chờ duyệt</button>
                <button onclick="filterGroupHealthTable('failed')" class="group-filter-btn px-2.5 py-1 rounded-lg text-[11px] font-semibold text-[#A8A29E] hover:text-[#FAF7F2]" id="btn-grp-filter-failed">🔴 Thường lỗi</button>
              </div>
            </div>

            <div class="overflow-x-auto rounded-2xl border border-[#2E2925] bg-[#141210]">
              <table class="w-full text-left text-xs font-sans">
                <thead class="bg-[#1C1815] border-b border-[#2E2925] text-[11px] font-mono text-[#A8A29E]">
                  <tr>
                    <th class="py-3 px-3.5">Group Facebook</th>
                    <th class="py-3 px-3">Khả Năng Đăng Bài</th>
                    <th class="py-3 px-3">Lưu Ý / Ghi Chú Nhóm (Note)</th>
                    <th class="py-3 px-3 text-center">Thống Kê</th>
                    <th class="py-3 px-3 text-center">Phân Phối</th>
                    <th class="py-3 px-3 text-right">Thao Tác</th>
                  </tr>
                </thead>
                <tbody id="groups-health-tbody" class="divide-y divide-[#2E2925] text-[11px]">
                  <!-- Populated dynamically -->
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- HÀNG ĐỢI & LỊCH SỬ BÀI ĐĂNG (TOPIC 1 QUEUE) -->
        <div class="claude-card rounded-3xl p-5 space-y-4">
          <div class="flex items-center justify-between border-b border-[#2C2723] pb-3">
            <div>
              <h3 class="text-xs font-bold text-[#FAF7F2] uppercase tracking-wider">Hàng Đợi Bài Đăng & Lịch Phân Phối (Topic 1)</h3>
              <p class="text-[11px] text-[#A8A29E]">Danh sách các bài đăng đang chờ hoặc đã hoàn tất xuất bản.</p>
            </div>
            <button onclick="clearAllPostsFromWeb()" class="text-xs px-3 py-1.5 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/20 font-semibold transition">
              🗑️ Xóa Sạch Tất Cả Bài
            </button>
          </div>

          <!-- Bộ lọc dạng bài đăng -->
          <div class="flex items-center gap-1.5 flex-wrap pt-1 border-b border-[#2C2723] pb-3">
            <span class="text-[11px] text-[#A8A29E] font-medium mr-1">Lọc dạng bài:</span>
            <button onclick="filterPostsType('all')" class="post-filter-btn px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-[#24201C] text-[#FAF7F2] border border-[#3E3832]" id="btn-post-filter-all">Tất cả bài</button>
            <button onclick="filterPostsType('personal_post')" class="post-filter-btn px-2.5 py-1 rounded-lg text-[11px] font-semibold text-[#A8A29E] hover:text-[#FAF7F2]" id="btn-post-filter-personal">👤 Trang cá nhân</button>
            <button onclick="filterPostsType('group_post')" class="post-filter-btn px-2.5 py-1 rounded-lg text-[11px] font-semibold text-[#A8A29E] hover:text-[#FAF7F2]" id="btn-post-filter-group">🌐 Group Facebook</button>
            <button onclick="filterPostsType('both')" class="post-filter-btn px-2.5 py-1 rounded-lg text-[11px] font-semibold text-[#A8A29E] hover:text-[#FAF7F2]" id="btn-post-filter-both">⚡ Cả hai</button>
            <button onclick="filterPostsType('pending_approval')" class="post-filter-btn px-2.5 py-1 rounded-lg text-[11px] font-semibold text-[#A8A29E] hover:text-[#FAF7F2]" id="btn-post-filter-pending">⏳ Chờ duyệt</button>
          </div>

          <!-- Posts List Container -->
          <div id="posts-list-container" class="space-y-3.5">
            <!-- Dynamically populated -->
          </div>
        </div>

      </div>

      <!-- ======================================================== -->
      <!-- TAB 4: BÌNH LUẬN & QUÉT NHÓM (AUTOCMT / TOPIC 2)         -->
      <!-- ======================================================== -->
      <div id="tab-autocmt" class="space-y-5 tab-content hidden">
        
        <!-- KHO NGUỒN BĐS & QUỸ CĂN TRONG NGÀY (INVENTORY RADAR) -->
        <div class="claude-card rounded-3xl p-6 space-y-5 border border-[#D96B43]/35 shadow-xl">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 border-b border-[#2C2723] pb-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-2xl bg-[#D96B43]/20 text-[#E87A5D] flex items-center justify-center text-xl shadow-inner border border-[#D96B43]/30">
                🏠
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="text-sm font-bold text-[#FAF7F2] uppercase tracking-wider">Kho Nguồn BĐS & Quỹ Căn Trong Ngày (Inventory Radar)</h3>
                  <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">Tesseract OCR Offline (Free)</span>
                </div>
                <p class="text-[11px] text-[#A8A29E]">Nhập text hoặc nạp ảnh bảng hàng (qua Telegram hoặc Web), hệ thống tự động bóc tách đặc điểm và radar bắt khách 24/7.</p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <div class="text-right mr-2 hidden sm:block">
                <span class="text-[10px] text-[#78716C] block">Topic Telegram Nạp Căn:</span>
                <span id="inv-topic-display" class="text-xs font-mono font-bold text-[#FAF7F2]">Topic #67 (Topic 2)</span>
              </div>
              <button onclick="changeInventoryTopicPrompt()" class="text-[11px] font-bold px-3 py-1.5 rounded-xl bg-[#24201C] hover:bg-[#2C2723] text-[#FAF7F2] border border-[#3E3832] transition">
                ⚙️ Đổi Topic
              </button>
            </div>
          </div>

          <!-- 4 KPI CARDS -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-xs">
            <div class="p-3.5 rounded-2xl bg-[#171412] border border-[#2E2925] flex items-center justify-between">
              <div>
                <span class="text-[10px] text-[#78716C] font-semibold block uppercase">Tổng Quỹ Căn</span>
                <span id="inv-kpi-total" class="text-xl font-bold font-mono text-[#FAF7F2]">0</span>
              </div>
              <span class="text-2xl opacity-60">📦</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-[#171412] border border-emerald-500/20 flex items-center justify-between">
              <div>
                <span class="text-[10px] text-emerald-400 font-semibold block uppercase">Đang Săn Khách</span>
                <span id="inv-kpi-available" class="text-xl font-bold font-mono text-emerald-400">0</span>
              </div>
              <span class="text-2xl opacity-60">🟢</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-[#171412] border border-sky-500/20 flex items-center justify-between">
              <div>
                <span class="text-[10px] text-sky-400 font-semibold block uppercase">Căn Cho Thuê</span>
                <span id="inv-kpi-rent" class="text-xl font-bold font-mono text-sky-400">0</span>
              </div>
              <span class="text-2xl opacity-60">🔑</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-[#171412] border border-amber-500/20 flex items-center justify-between">
              <div>
                <span class="text-[10px] text-amber-400 font-semibold block uppercase">Bán / Chuyển Nhượng</span>
                <span id="inv-kpi-sale" class="text-xl font-bold font-mono text-amber-400">0</span>
              </div>
              <span class="text-2xl opacity-60">🏷️</span>
            </div>
          </div>

          <!-- 2 CÁCH NẠP CĂN NHANH -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Cách 1: Nạp từ Văn Bản / Copy Paste từ Zalo -->
            <div class="p-4 rounded-2xl bg-[#171412] border border-[#2E2925] space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-[#FAF7F2] flex items-center gap-1.5">
                  <span>📝</span> Cách 1: Dán Tin Nhắn / Text Nguồn
                </span>
                <span class="text-[10px] text-[#A8A29E]">Dán 1 hoặc nhiều căn cùng lúc</span>
              </div>
              <textarea id="inv-input-text" rows="3" class="w-full bg-[#1C1816] border border-[#3E3832] rounded-xl px-3 py-2 text-xs text-[#FAF7F2] placeholder-[#78716C] focus:outline-none focus:border-[#D96B43] font-mono leading-relaxed resize-none" placeholder="VD: Sky Oasis S2 2PN full đồ 10tr vào ngay LH 0988xxx&#10;Haven Park Studio cơ bản 6.5tr cọc 1 thanh 3..."></textarea>
              <div class="flex items-center justify-between">
                <span class="text-[10px] text-[#78716C]">💡 Regex & NLP Parser Ecopark tự bóc tách</span>
                <button id="btn-scan-text" onclick="scanAndAddPropertiesFromText()" class="bg-[#D96B43] hover:bg-[#E27D56] text-white text-xs font-bold px-3.5 py-1.5 rounded-xl transition shadow flex items-center gap-1">
                  <span>⚡</span> <span>Bóc Tách & Nạp Căn</span>
                </button>
              </div>
            </div>

            <!-- Cách 2: Tesseract OCR Ảnh Bảng Hàng & Folder Ảnh -->
            <div class="p-4 rounded-2xl bg-[#171412] border border-[#2E2925] space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-[#FAF7F2] flex items-center gap-1.5">
                  <span>📸</span> Cách 2: Tải Ảnh / Folder Căn Hộ
                </span>
                <span class="text-[10px] text-emerald-400 font-semibold">Tesseract.js OCR Offline</span>
              </div>
              <div class="border-2 border-dashed border-[#3E3832] hover:border-[#D96B43] rounded-xl p-3 text-center transition cursor-pointer relative bg-[#1C1816]/50" onclick="document.getElementById('inv-input-file').click()">
                <input type="file" id="inv-input-file" accept="image/*" multiple class="hidden" onchange="previewInventoryImage(event)" />
                <input type="file" id="inv-input-folder" webkitdirectory directory multiple class="hidden" onchange="previewInventoryFolder(event)" />
                <div id="inv-file-preview-wrap" class="space-y-1">
                  <span class="text-2xl block">🖼️</span>
                  <span id="inv-file-name" class="text-xs text-[#A8A29E] block">Bấm để chọn nhiều ảnh hoặc kéo thả vào đây</span>
                  <div class="flex items-center justify-center gap-2 pt-1">
                    <span class="text-[10px] text-[#78716C]">Hỗ trợ PNG, JPG</span>
                    <span class="text-[10px] text-[#78716C]">•</span>
                    <button type="button" onclick="event.stopPropagation(); document.getElementById('inv-input-folder').click()" class="text-[10px] text-[#D96B43] hover:underline font-bold">
                      📁 Hoặc tải cả Folder ảnh
                    </button>
                  </div>
                </div>
              </div>
              <div class="flex items-center justify-between">
                <span id="inv-ocr-status" class="text-[10px] text-[#A8A29E]">Sẵn sàng quét ảnh</span>
                <button id="btn-scan-image" onclick="scanAndAddPropertiesFromImage()" class="bg-[#2E2925] hover:bg-[#3E3832] text-[#FAF7F2] text-xs font-bold px-3.5 py-1.5 rounded-xl transition border border-[#44403C] flex items-center gap-1">
                  <span>🔍</span> <span>Quét Chữ OCR & Nạp</span>
                </button>
              </div>
            </div>
          </div>

          <!-- BẢNG DANH SÁCH QUỸ CĂN -->
          <div class="space-y-3">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div class="flex items-center gap-2 overflow-x-auto pb-1">
                <button onclick="filterInventoryTable('all')" id="btn-inv-flt-all" class="inv-flt-btn text-[11px] font-bold px-3 py-1 rounded-xl bg-[#D96B43]/15 text-[#FAF7F2] border border-[#D96B43]/30 transition">Tất cả</button>
                <button onclick="filterInventoryTable('available')" id="btn-inv-flt-available" class="inv-flt-btn text-[11px] font-bold px-3 py-1 rounded-xl text-[#A8A29E] hover:text-white transition">🟢 Đang săn khách</button>
                <button onclick="filterInventoryTable('rent')" id="btn-inv-flt-rent" class="inv-flt-btn text-[11px] font-bold px-3 py-1 rounded-xl text-[#A8A29E] hover:text-white transition">🔑 Cho thuê</button>
                <button onclick="filterInventoryTable('sale')" id="btn-inv-flt-sale" class="inv-flt-btn text-[11px] font-bold px-3 py-1 rounded-xl text-[#A8A29E] hover:text-white transition">🏷️ Bán</button>
                <button onclick="filterInventoryTable('done')" id="btn-inv-flt-done" class="inv-flt-btn text-[11px] font-bold px-3 py-1 rounded-xl text-[#A8A29E] hover:text-white transition">✅ Đã chốt</button>
              </div>
              <span id="inv-table-count" class="text-[11px] text-[#78716C] font-mono">Hiển thị: 0 căn</span>
            </div>

            <div class="overflow-x-auto rounded-2xl border border-[#2E2925] bg-[#171412]">
              <table class="w-full text-left border-collapse text-xs">
                <thead>
                  <tr class="border-b border-[#2E2925] bg-[#1C1816] text-[#A8A29E] text-[10px] uppercase tracking-wider font-semibold">
                    <th class="py-3 px-3">Phân Khu & Căn</th>
                    <th class="py-3 px-3">Vị Trí (Google Map)</th>
                    <th class="py-3 px-3 text-center">Nhu Cầu</th>
                    <th class="py-3 px-3 text-center">Diện Tích</th>
                    <th class="py-3 px-3 text-right">Mức Giá</th>
                    <th class="py-3 px-3">Nội Thất</th>
                    <th class="py-3 px-3">Liên Hệ</th>
                    <th class="py-3 px-3 text-center">Tự Động CMT</th>
                    <th class="py-3 px-3 text-center">Trạng Thái</th>
                    <th class="py-3 px-3 text-center">Thao Tác</th>
                  </tr>
                </thead>
                <tbody id="inv-properties-tbody" class="divide-y divide-[#2E2925]">
                  <tr>
                    <td colspan="10" class="py-6 text-center text-[#78716C] text-xs">
                      Chưa có căn hộ nào trong kho. Hãy dán tin nhắn hoặc nạp ảnh bảng hàng phía trên!
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        
        <div class="claude-card rounded-3xl p-6 space-y-5">
          <div class="flex items-center justify-between border-b border-[#2C2723] pb-4">
            <div>
              <h3 class="text-xs font-bold text-[#FAF7F2] uppercase tracking-wider">Topic 2 — Bình Luận Có Hậu Kiểm DOM Xác Minh (F02)</h3>
              <p class="text-[11px] text-[#A8A29E]">Gửi link Facebook kèm nội dung vào Topic 2 Telegram để bot bình luận ngay lập tức.</p>
            </div>
            <div class="flex items-center gap-2">
              <span id="autocmt-switch-badge" class="text-[10px] font-mono px-2.5 py-1 rounded-full bg-[#24201C] text-[#A8A29E] border border-[#38332E]">ĐANG TẮT</span>
              <button id="btn-toggle-autocmt" onclick="toggleAutoComment()" class="bg-[#D96B43] hover:bg-[#E27D56] text-white text-xs font-bold px-3.5 py-1.5 rounded-xl transition shadow">
                🟢 Bật Quét
              </button>
            </div>
          </div>

          <!-- Groups & Keywords Monitored -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
            <div class="p-4 rounded-2xl bg-[#171412] border border-[#2E2925] space-y-2.5">
              <div class="flex items-center justify-between">
                <span class="font-bold text-[#FAF7F2]">👥 Nhóm Facebook Mục Tiêu</span>
                <span id="monitored-groups-count" class="font-mono text-[#E87A5D] font-bold">0</span>
              </div>
              <div id="groups-chip-list" class="flex flex-wrap gap-2 min-h-[40px] items-center">
                <!-- Group Chips -->
              </div>
            </div>

            <div class="p-4 rounded-2xl bg-[#171412] border border-[#2E2925] space-y-2.5">
              <div class="flex items-center justify-between">
                <span class="font-bold text-[#FAF7F2]">🔑 Từ Khóa Nhận Diện</span>
                <span id="monitored-keywords-count" class="font-mono text-[#F59E0B] font-bold">0</span>
              </div>
              <div id="keywords-chip-list" class="flex flex-wrap gap-2 min-h-[40px] items-center">
                <!-- Keyword Chips -->
              </div>
            </div>
          </div>

          <!-- Logs Table with Verification Badge -->
          <div class="space-y-3">
            <span class="text-xs font-bold text-[#FAF7F2] uppercase tracking-wider block">Nhật Ký Bình Luận Gần Nhất (Đã Hậu Kiểm DOM Xác Minh)</span>
            <div class="overflow-x-auto rounded-2xl border border-[#2E2925] bg-[#171412]/70">
              <table class="w-full text-left text-xs font-sans">
                <thead class="bg-[#1C1815] border-b border-[#2E2925] text-[11px] font-mono text-[#A8A29E]">
                  <tr>
                    <th class="py-3 px-4">Thời gian</th>
                    <th class="py-3 px-4">Tài khoản</th>
                    <th class="py-3 px-4">Bài viết</th>
                    <th class="py-3 px-4">Nội dung</th>
                    <th class="py-3 px-4">Trạng thái xác minh</th>
                  </tr>
                </thead>
                <tbody id="comment-logs-tbody" class="divide-y divide-[#2E2925] text-[11px]">
                  <!-- Populated dynamically -->
                </tbody>
              </table>
            </div>
          </div>

        </div>

      </div>

      <!-- ======================================================== -->
      <!-- TAB 5: TOPIC 3-5 (GROWTH & QUÉT MEM & TƯƠNG TÁC)         -->
      <!-- ======================================================== -->
      <div id="tab-growth" class="space-y-6 tab-content hidden">
        
        <!-- MODULE 1: TOPIC 3 - QUÉT SÂU THÀNH VIÊN MỚI TRONG GROUP -->
        <div class="claude-card rounded-3xl p-6 space-y-5 border border-[#3E3832] bg-[#1E1A17]">
          <div class="flex items-center justify-between border-b border-[#2C2723] pb-4">
            <div class="flex items-center gap-3">
              <span class="text-2xl">👥</span>
              <div>
                <h3 class="text-sm font-bold text-[#FAF7F2] tracking-tight">Topic 3 — Quét Sâu Thành Viên Mới Trong Group Facebook</h3>
                <p class="text-[11px] text-[#A8A29E]">Tự động cuộn sâu (10 lần) nạp 150+ thành viên mới gia nhập, bóc tách link Profile trực tiếp cho Sale</p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <button onclick="resetMemberBaselineFromWeb()" class="text-xs px-3 py-1.5 rounded-xl bg-[#24201C] hover:bg-[#2C2723] text-[#FAF7F2] border border-[#3E3832] font-semibold transition" title="Xóa mốc cũ để quét lại toàn bộ thành viên">
                🔄 Đặt Lại Mốc (Reset)
              </button>
            </div>
          </div>

          <!-- Form nhập link Group -->
          <div class="space-y-3">
            <div class="flex flex-col sm:flex-row gap-2.5">
              <div class="relative flex-1">
                <input type="text" id="web-member-group-url"
                  placeholder="Dán link Facebook Group (VD: https://www.facebook.com/groups/1398246037427398)..."
                  value="https://www.facebook.com/groups/1398246037427398"
                  class="w-full rounded-2xl bg-[#141210] border border-[#2E2925] px-4 py-3 text-xs font-mono text-[#FAF7F2] focus:border-[#D96B43] focus:outline-none placeholder-[#78716C] transition" />
              </div>

              <!-- Dropdown chọn nhanh Group đã cấu hình -->
              <select id="web-member-group-select" onchange="onSelectSavedGroup(this.value)"
                class="rounded-2xl bg-[#141210] border border-[#2E2925] px-3.5 py-3 text-xs font-sans text-[#FAF7F2] focus:border-[#D96B43] focus:outline-none transition">
                <option value="">-- Chọn nhanh Group đã lưu --</option>
              </select>

              <button id="btn-scan-members" onclick="scanGroupMembersFromWeb()"
                class="px-5 py-3 rounded-2xl bg-[#D96B43] hover:bg-[#E27D56] text-white text-xs font-bold transition shadow-lg shadow-[#D96B43]/25 flex items-center justify-center gap-2 shrink-0">
                <span id="scan-members-icon">🔎</span>
                <span id="scan-members-text">QUÉT SÂU THÀNH VIÊN</span>
              </button>
            </div>

            <!-- Trạng thái tiến trình quét -->
            <div id="scan-progress-box" class="hidden p-3.5 rounded-2xl bg-[#D96B43]/10 border border-[#D96B43]/30 text-xs text-[#E87A5D] flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-[#E87A5D] animate-ping"></span>
              <span id="scan-progress-msg">Đang mở trang Facebook Group, cuộn sâu 10 lần và bóc tách thành viên mới...</span>
            </div>
          </div>

          <!-- Chỉ số thống kê kết quả quét -->
          <div id="scanned-metrics-row" class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
            <div class="p-3.5 rounded-2xl bg-[#141210] border border-[#2E2925]">
              <span class="text-[10px] text-[#A8A29E] uppercase font-mono block">Tổng Hồ Sơ Quét Được</span>
              <span id="stat-scanned-total" class="text-xl font-bold font-mono text-[#FAF7F2]">0</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-[#141210] border border-[#2E2925]">
              <span class="text-[10px] text-[#A8A29E] uppercase font-mono block">Mới Gia Nhập Hôm Nay</span>
              <span id="stat-scanned-today" class="text-xl font-bold font-mono text-emerald-400">0</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-[#141210] border border-[#2E2925]">
              <span class="text-[10px] text-[#A8A29E] uppercase font-mono block">Thành Viên Mới So Với Mốc</span>
              <span id="stat-scanned-new" class="text-xl font-bold font-mono text-[#E87A5D]">0</span>
            </div>
          </div>

          <!-- Bộ lọc danh sách thành viên & Nút Copy Link -->
          <div class="flex flex-wrap items-center justify-between gap-3 pt-1 border-t border-[#2C2723]">
            <div class="flex items-center gap-1.5 text-xs">
              <button onclick="filterScannedMembers('all')" id="filter-btn-all" class="px-3 py-1.5 rounded-xl font-semibold transition bg-[#D96B43]/20 text-[#FAF7F2] border border-[#D96B43]/30">
                Tất Cả (<span id="count-filter-all">0</span>)
              </button>
              <button onclick="filterScannedMembers('today')" id="filter-btn-today" class="px-3 py-1.5 rounded-xl font-semibold transition text-[#A8A29E] hover:text-[#FAF7F2] hover:bg-[#24201C]">
                🔥 Mới Hôm Nay (<span id="count-filter-today">0</span>)
              </button>
              <button onclick="filterScannedMembers('other')" id="filter-btn-other" class="px-3 py-1.5 rounded-xl font-semibold transition text-[#A8A29E] hover:text-[#FAF7F2] hover:bg-[#24201C]">
                Trước Đó (<span id="count-filter-other">0</span>)
              </button>
            </div>

            <button onclick="copyAllScannedMemberLinks()" class="text-xs px-3.5 py-1.5 rounded-xl bg-[#24201C] hover:bg-[#2C2723] text-[#FAF7F2] border border-[#3E3832] font-semibold transition flex items-center gap-1.5">
              <span>📋</span> Sao Chép Danh Sách Link
            </button>
          </div>

          <!-- Bảng hiển thị danh sách thành viên đã quét -->
          <div class="overflow-x-auto rounded-2xl border border-[#2E2925] bg-[#141210]">
            <table class="w-full text-left text-xs font-sans">
              <thead class="bg-[#1A1613] border-b border-[#2E2925] text-[11px] font-mono text-[#A8A29E]">
                <tr>
                  <th class="py-3 px-4">#</th>
                  <th class="py-3 px-4">Thành viên & Thời gian gia nhập</th>
                  <th class="py-3 px-4">Link Trang Cá Nhân (Profile)</th>
                  <th class="py-3 px-4 text-right">Thao Tác Sale</th>
                </tr>
              </thead>
              <tbody id="scanned-members-tbody" class="divide-y divide-[#2E2925] text-[11px]">
                <tr>
                  <td colspan="4" class="py-12 text-center text-[#A8A29E] font-mono text-xs">
                    Chưa quét dữ liệu. Hãy bấm "QUÉT SÂU THÀNH VIÊN" ở trên để bóc tách danh sách!
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- MODULE 2 & 3: TOPIC 4 & 5 (KẾT BẠN & THẢ CẢM XÚC) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          
          <!-- TOPIC 4: KẾT BẠN MỤC TIÊU -->
          <div class="claude-card rounded-3xl p-6 space-y-4 border-t-4 border-t-[#F59E0B]">
            <div class="flex items-center gap-2.5">
              <span class="text-xl">🤝</span>
              <div>
                <h4 class="text-xs font-bold uppercase tracking-wider text-[#FAF7F2]">Topic 4: Kết Bạn Mục Tiêu</h4>
                <p class="text-[11px] text-[#A8A29E]">Gửi lời mời kết bạn tự động từ tài khoản Eco Trang</p>
              </div>
            </div>

            <div class="space-y-2.5">
              <input type="text" id="web-friend-profile-url"
                placeholder="Dán link Profile Facebook (VD: https://facebook.com/profile.php?id=...)"
                class="w-full rounded-2xl bg-[#141210] border border-[#2E2925] px-4 py-2.5 text-xs font-mono text-[#FAF7F2] focus:border-[#F59E0B] focus:outline-none placeholder-[#78716C] transition" />
              
              <button id="btn-send-friend" onclick="sendTargetFriendFromWeb()"
                class="w-full py-2.5 px-4 rounded-xl bg-[#F59E0B] hover:bg-[#D97706] text-black text-xs font-bold transition shadow-md shadow-[#F59E0B]/20 flex items-center justify-center gap-2">
                <span>➕ Gửi Lời Mời Kết Bạn Ngay</span>
              </button>
            </div>
            <div id="web-friend-result" class="hidden p-3 rounded-xl bg-[#141210] border border-[#2E2925] text-xs font-mono"></div>
          </div>

          <!-- TOPIC 5: THẢ CẢM XÚC BÀI VIẾT / STORY -->
          <div class="claude-card rounded-3xl p-6 space-y-4 border-t-4 border-t-rose-500">
            <div class="flex items-center gap-2.5">
              <span class="text-xl">❤️</span>
              <div>
                <h4 class="text-xs font-bold uppercase tracking-wider text-[#FAF7F2]">Topic 5: Thả Cảm Xúc Bài Viết & Story</h4>
                <p class="text-[11px] text-[#A8A29E]">Tương tác Like/Love vào bài viết hoặc Story Facebook</p>
              </div>
            </div>

            <div class="space-y-2.5">
              <input type="text" id="web-react-url"
                placeholder="Dán link Bài viết hoặc Story Facebook..."
                class="w-full rounded-2xl bg-[#141210] border border-[#2E2925] px-4 py-2.5 text-xs font-mono text-[#FAF7F2] focus:border-rose-500 focus:outline-none placeholder-[#78716C] transition" />

              <div class="flex items-center gap-2">
                <select id="web-react-type" class="flex-1 rounded-xl bg-[#141210] border border-[#2E2925] px-3 py-2 text-xs text-[#FAF7F2] focus:outline-none">
                  <option value="like">👍 Thích (Like)</option>
                  <option value="love">❤️ Yêu thích (Love)</option>
                </select>

                <button id="btn-send-react" onclick="sendTargetReactFromWeb()"
                  class="flex-1 py-2.5 px-4 rounded-xl bg-rose-500 hover:bg-rose-600 text-white text-xs font-bold transition shadow-md shadow-rose-500/20 flex items-center justify-center gap-2">
                  <span>⚡ Thả Cảm Xúc</span>
                </button>
              </div>
            </div>
            <div id="web-react-result" class="hidden p-3 rounded-xl bg-[#141210] border border-[#2E2925] text-xs font-mono"></div>
          </div>

        </div>

      </div>

      <!-- ======================================================== -->
      <!-- TAB 6: QUẢN LÝ NICK & PROXY (ACCOUNTS)                   -->
      <!-- ======================================================== -->
      <div id="tab-accounts" class="space-y-5 tab-content hidden">
        
        <div class="claude-card rounded-3xl p-5 flex items-center justify-between">
          <div>
            <h3 class="text-xs font-bold text-[#FAF7F2] uppercase tracking-wider">Hồ Sơ Tài Khoản Facebook & Proxy Riêng Biệt</h3>
            <p class="text-[11px] text-[#A8A29E]">Mỗi tài khoản được chạy trên một hồ sơ Chrome độc lập để chống checkpoint.</p>
          </div>
          <button onclick="openAddAccountModal()" class="px-4 py-2 rounded-xl bg-[#D96B43] hover:bg-[#E27D56] text-xs font-bold text-white transition shadow-md shadow-[#D96B43]/20">
            ➕ Thêm Tài Khoản
          </button>
        </div>

        <div id="accounts-cards-container" class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <!-- Accounts Populated -->
        </div>

      </div>

      <!-- ======================================================== -->
      <!-- TAB 7: CONSOLE LIVE LOGS                                 -->
      <!-- ======================================================== -->
      <div id="tab-logs" class="space-y-5 tab-content hidden">
        
        <div class="claude-card rounded-3xl p-5 flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <span class="text-base">💻</span>
            <h3 class="text-xs font-bold text-[#FAF7F2] uppercase tracking-wider">Terminal Giám Sát Tiến Trình (Realtime Engine Log)</h3>
          </div>
          <button onclick="clearConsoleLog()" class="px-3 py-1.5 rounded-xl bg-[#24201C] hover:bg-[#2C2723] text-xs text-[#D6D3D1] font-mono border border-[#38332E]">
            Xóa màn hình
          </button>
        </div>

        <div id="terminal-screen" class="p-5 rounded-3xl bg-[#0D0B0A] border border-[#2C2723] text-[#D6D3D1] font-mono text-[11px] h-96 overflow-y-auto space-y-2 custom-scroll shadow-inner">
          <div class="text-[#E87A5D]">[READY] FalconX Autonomous Engine đang chạy ngầm trên port 3300.</div>
        </div>

      </div>

    </main>

  </div>

  <!-- ======================================================== -->
  <!-- MODAL: XEM MÀN HÌNH CHROME                               -->
  <!-- ======================================================== -->
  <div id="screen-modal" class="fixed inset-0 bg-black/85 backdrop-blur-md z-50 flex items-center justify-center p-5 hidden">
    <div class="bg-[#171412] border border-[#38332E] rounded-3xl max-w-4xl w-full p-5 space-y-4 shadow-2xl">
      <div class="flex items-center justify-between">
        <h3 class="text-xs font-bold text-[#FAF7F2] uppercase tracking-wider flex items-center gap-2">
          <span>🖥️</span> Màn Hình Trình Duyệt Facebook Realtime
        </h3>
        <div class="flex items-center gap-2">
          <a href="https://www.facebook.com" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 bg-[#1877F2]/15 hover:bg-[#1877F2]/25 text-[#4599FF] text-xs font-bold rounded-xl border border-[#1877F2]/30 flex items-center gap-1.5 transition">
            🌐 Vào Facebook ↗
          </a>
          <button onclick="resumeLoginFromModal()" class="px-3 py-1.5 bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-400 text-xs font-bold rounded-xl border border-emerald-500/30 flex items-center gap-1 transition">
            👉 Nhấp Chọn Eco Trang
          </button>
          <button onclick="refreshScreenModal()" class="px-3 py-1.5 bg-[#24201C] text-[#FAF7F2] text-xs rounded-xl hover:bg-[#2C2723] transition">🔄 Làm mới</button>
          <button onclick="closeScreenModal()" class="px-3 py-1.5 bg-[#24201C] text-[#FAF7F2] text-xs rounded-xl hover:bg-[#2C2723] transition">✕ Đóng</button>
        </div>
      </div>
      <div class="rounded-2xl overflow-hidden border border-[#2E2925] bg-black flex items-center justify-center min-h-[360px]">
        <img id="screen-img" src="" class="max-w-full h-auto object-contain" alt="Chrome Screen" />
      </div>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- MODAL: THÊM TÀI KHOẢN MỚI                                -->
  <!-- ======================================================== -->
  <div id="add-account-modal" class="fixed inset-0 bg-black/85 backdrop-blur-md z-50 flex items-center justify-center p-5 hidden">
    <div class="bg-[#171412] border border-[#38332E] rounded-3xl max-w-lg w-full p-6 space-y-5 shadow-2xl">
      <div class="flex items-center justify-between border-b border-[#2C2723] pb-3.5">
        <h3 class="text-xs font-bold text-[#FAF7F2] uppercase tracking-wider flex items-center gap-2">
          <span>➕</span> Thêm Tài Khoản Facebook
        </h3>
        <button onclick="closeAddAccountModal()" class="text-[#A8A29E] hover:text-white text-xs">✕</button>
      </div>

      <div class="space-y-3.5 text-xs">
        <div>
          <label class="text-[11px] text-[#A8A29E] font-semibold block mb-1">Tên Gợi Nhớ (Alias)</label>
          <input type="text" id="cookie-acc-name" placeholder="Ví dụ: Nick Bán Hàng 02" class="w-full bg-[#100E0C] border border-[#38332E] rounded-2xl px-4 py-2.5 text-[#FAF7F2] focus:outline-none focus:border-[#D96B43] font-sans" />
        </div>

        <div>
          <label class="text-[11px] text-[#A8A29E] font-semibold block mb-1">Chuỗi Cookie Facebook (Hỗ trợ Cookie / JSON / Dòng mua nick UID|Pass|2FA|Cookie)</label>
          <textarea id="cookie-acc-input" rows="4" placeholder="Dán cookie c_user=... hoặc dán nguyên cả dòng mua nick (UID|Pass|2FA|Cookie|Token|Mail) vào đây..." class="w-full bg-[#100E0C] border border-[#38332E] rounded-2xl p-3.5 text-[#FAF7F2] focus:outline-none focus:border-[#D96B43] font-mono text-[11px]"></textarea>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1">
            <label class="text-[11px] text-[#A8A29E] font-semibold">Proxy Riêng Biệt (Không bắt buộc)</label>
            <button type="button" onclick="testProxyInModal('cookie-acc-proxy', 'cookie-proxy-result')" class="text-[10px] text-[#E87A5D] hover:underline font-mono">⚡ Test Proxy Ngay</button>
          </div>
          <input type="text" id="cookie-acc-proxy" placeholder="ip:port hoặc http://user:pass@ip:port" class="w-full bg-[#100E0C] border border-[#38332E] rounded-2xl px-4 py-2.5 text-[#FAF7F2] focus:outline-none focus:border-[#D96B43] font-mono text-[11px]" />
          <div id="cookie-proxy-result" class="text-[10px] mt-1.5 font-mono hidden p-2 rounded-xl border"></div>
        </div>

        <div class="flex items-center gap-2 pt-1">
          <input type="checkbox" id="cookie-make-active" class="rounded bg-[#171412] border-[#38332E] text-[#D96B43] focus:ring-0" />
          <label for="cookie-make-active" class="text-[#D6D3D1] text-xs">Đặt làm tài khoản hoạt động chính sau khi thêm</label>
        </div>

        <button id="btn-submit-cookie" onclick="submitLoginCookie()" class="w-full py-3 rounded-2xl bg-[#D96B43] hover:bg-[#E27D56] text-white font-bold text-xs shadow-lg shadow-[#D96B43]/25 transition">
          Xác Thực & Thêm Tài Khoản
        </button>
      </div>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- MODAL: CẬP NHẬT ẢNH ĐẠI DIỆN TÀI KHOẢN                   -->
  <!-- ======================================================== -->
  <div id="avatar-modal" class="fixed inset-0 bg-black/85 backdrop-blur-md z-50 flex items-center justify-center p-5 hidden">
    <div class="bg-[#171412] border border-[#38332E] rounded-3xl max-w-md w-full p-6 space-y-5 shadow-2xl">
      <div class="flex items-center justify-between border-b border-[#2C2723] pb-3.5">
        <h3 class="text-xs font-bold text-[#FAF7F2] uppercase tracking-wider flex items-center gap-2">
          <span>📸</span> Cập Nhật Ảnh Đại Diện Facebook
        </h3>
        <button onclick="closeAvatarModal()" class="text-[#A8A29E] hover:text-white text-xs">✕</button>
      </div>

      <div class="space-y-4 text-xs">
        <div class="flex items-center gap-4 p-3.5 rounded-2xl bg-[#1F1B18] border border-[#2E2925]">
          <img id="avatar-modal-preview" src="https://graph.facebook.com/61577949601039/picture?type=large" class="w-16 h-16 rounded-2xl object-cover border border-[#44403C] shadow flex-shrink-0" />
          <div class="min-w-0 flex-1 space-y-1">
            <h4 id="avatar-modal-name" class="text-sm font-bold text-[#FAF7F2] truncate">Eco Trang</h4>
            <span id="avatar-modal-uid" class="text-[11px] text-[#A8A29E] font-mono block">UID: 61577949601039</span>
            <span class="text-[10px] text-emerald-400 font-mono font-bold flex items-center gap-1">
              <span>●</span> Phiên Facebook LIVE
            </span>
          </div>
        </div>

        <!-- Option 1: Auto Sync from Browser -->
        <div class="p-4 rounded-2xl bg-[#14110F] border border-[#2E2925] space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-bold text-[#FAF7F2]">Cách 1: Trích xuất tự động từ Chrome</span>
            <span class="text-[9px] px-2 py-0.5 rounded-full bg-[#D96B43]/20 text-[#E87A5D] border border-[#D96B43]/30 font-bold">KHUYÊN DÙNG</span>
          </div>
          <p class="text-[11px] text-[#A8A29E] leading-relaxed">Hệ thống sẽ lấy avatar thật từ phiên Facebook của Chrome và lưu vĩnh viễn trên máy chủ để chống link hết hạn.</p>
          <button id="btn-modal-sync-avatar" onclick="syncAvatarFromModal()" class="w-full py-2.5 rounded-xl bg-[#D96B43]/15 hover:bg-[#D96B43]/25 text-[#E87A5D] border border-[#D96B43]/30 font-bold text-xs flex items-center justify-center gap-2 transition">
            <span id="sync-avatar-icon">🔄</span> Tự Động Đồng Bộ Từ Chrome Ngay
          </button>
        </div>

        <!-- Option 2: Custom URL or File Upload -->
        <div class="p-4 rounded-2xl bg-[#14110F] border border-[#2E2925] space-y-3">
          <span class="text-[11px] font-bold text-[#FAF7F2] block">Cách 2: Nhập link ảnh hoặc tải tệp lên</span>
          <div>
            <label class="text-[10px] text-[#A8A29E] font-semibold block mb-1">Dán link ảnh trực tiếp (URL)</label>
            <input type="text" id="avatar-url-input" placeholder="https://... ảnh avatar" class="w-full bg-[#100E0C] border border-[#38332E] rounded-xl px-3 py-2 text-[#FAF7F2] focus:outline-none focus:border-[#D96B43] text-xs font-mono" />
          </div>
          <div>
            <label class="text-[10px] text-[#A8A29E] font-semibold block mb-1">Hoặc tải file ảnh từ máy (JPG/PNG)</label>
            <input type="file" id="avatar-file-input" accept="image/*" onchange="handleAvatarFileSelect(event)" class="w-full text-xs text-[#A8A29E] file:mr-3 file:py-1.5 file:px-3 file:rounded-xl file:border file:border-[#38332E] file:text-xs file:font-semibold file:bg-[#24201C] file:text-[#FAF7F2] hover:file:bg-[#2C2723]" />
          </div>
          <button id="btn-save-manual-avatar" onclick="saveManualAvatar()" class="w-full py-2.5 rounded-xl bg-[#D96B43] hover:bg-[#E27D56] text-white font-bold text-xs shadow-md shadow-[#D96B43]/25 transition">
            💾 Lưu Ảnh Đại Diện Này
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- MODAL: CẤU HÌNH & TEST PROXY TÀI KHOẢN                  -->
  <!-- ======================================================== -->
  <div id="proxy-modal" class="fixed inset-0 bg-black/85 backdrop-blur-md z-50 flex items-center justify-center p-5 hidden">
    <div class="bg-[#171412] border border-[#38332E] rounded-3xl max-w-md w-full p-6 space-y-5 shadow-2xl">
      <div class="flex items-center justify-between border-b border-[#2C2723] pb-3.5">
        <h3 class="text-xs font-bold text-[#FAF7F2] uppercase tracking-wider flex items-center gap-2">
          <span>🛡️</span> Cấu Hình Proxy Riêng Biệt
        </h3>
        <button onclick="closeProxyModal()" class="text-[#A8A29E] hover:text-white text-xs">✕</button>
      </div>

      <div class="space-y-4 text-xs">
        <div>
          <label class="text-[11px] text-[#A8A29E] font-semibold block mb-1">Tài khoản:</label>
          <div id="proxy-modal-accname" class="font-bold text-[#FAF7F2] text-sm"></div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1">
            <label class="text-[11px] text-[#A8A29E] font-semibold">Địa chỉ Proxy (HTTP/SOCKS5):</label>
            <span class="text-[10px] text-[#78716C]">Hỗ trợ user:pass</span>
          </div>
          <input type="text" id="proxy-modal-input" placeholder="ip:port hoặc ip:port:user:pass hoặc http://user:pass@ip:port" class="w-full bg-[#100E0C] border border-[#38332E] rounded-2xl px-4 py-2.5 text-[#FAF7F2] focus:outline-none focus:border-[#D96B43] font-mono text-[11px]" />
          <p class="text-[10px] text-[#78716C] mt-1">Để trống nếu muốn nick chạy IP mạng nội bộ trực tiếp (không qua proxy).</p>
        </div>

        <!-- Kết quả test proxy trực quan -->
        <div id="proxy-modal-test-box" class="p-3.5 rounded-2xl bg-[#100E0C] border border-[#2E2925] space-y-1.5 hidden font-mono text-[11px]"></div>

        <div class="flex items-center gap-2 pt-2">
          <button type="button" onclick="testProxyInConfigModal()" id="btn-modal-test-proxy" class="flex-1 py-2.5 rounded-xl bg-[#24201C] hover:bg-[#2C2723] text-[#FAF7F2] border border-[#3E3832] font-semibold transition flex items-center justify-center gap-1.5">
            <span>⚡</span> Test Proxy Ngay
          </button>
          <button type="button" onclick="saveProxyFromModal()" id="btn-modal-save-proxy" class="flex-1 py-2.5 rounded-xl bg-[#D96B43] hover:bg-[#E27D56] text-white font-bold transition shadow-md shadow-[#D96B43]/20 flex items-center justify-center gap-1.5">
            <span>💾</span> Lưu Proxy
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- MODAL: KIỂM TRA & RÀNG BUỘC BẢO VỆ PROXY (STRICT PROXY)   -->
  <!-- ======================================================== -->
  <div id="proxy-inspect-modal" class="fixed inset-0 bg-black/85 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-[#171412] border border-[#38332E] rounded-3xl max-w-lg w-full p-6 space-y-4 shadow-2xl relative overflow-hidden animate-in fade-in zoom-in-95 duration-150">
      <div class="absolute top-0 right-0 w-36 h-36 bg-[#D96B43]/5 rounded-full blur-2xl pointer-events-none"></div>

      <!-- Header -->
      <div class="flex items-center justify-between border-b border-[#2C2723] pb-3.5">
        <div class="flex items-center gap-2.5">
          <span class="w-8 h-8 rounded-xl bg-amber-500/15 border border-amber-500/30 flex items-center justify-center text-base">🛡️</span>
          <div>
            <h3 class="text-xs font-bold text-[#FAF7F2] uppercase tracking-wider">Kiểm Tra & Ràng Buộc Proxy</h3>
            <p class="text-[10px] text-[#A8A29E]">Chống rò rỉ IP mạng máy thật - Bảo vệ tài khoản tuyệt đối</p>
          </div>
        </div>
        <button onclick="closeProxyInspectModal()" class="w-7 h-7 rounded-xl bg-[#24201C] hover:bg-[#2F2924] text-[#A8A29E] hover:text-white text-xs flex items-center justify-center transition">✕</button>
      </div>

      <!-- Account Card Header -->
      <div class="p-3 rounded-2xl bg-[#1F1B18] border border-[#2E2925] flex items-center justify-between gap-3">
        <div class="flex items-center gap-2.5 min-w-0">
          <img id="proxy-inspect-avatar" src="https://graph.facebook.com/61577949601039/picture?type=large" class="w-10 h-10 rounded-xl object-cover border border-[#44403C] flex-shrink-0" />
          <div class="min-w-0">
            <h4 id="proxy-inspect-accname" class="text-xs font-bold text-[#FAF7F2] truncate">Eco Trang</h4>
            <span id="proxy-inspect-accuid" class="text-[10px] font-mono text-[#A8A29E] block">UID: 61577949601039</span>
          </div>
        </div>
        <div id="proxy-inspect-bind-badge" class="flex-shrink-0">
          <!-- Dynamic Live Badge -->
        </div>
      </div>

      <!-- Inspection Content Container -->
      <div id="proxy-inspect-content" class="space-y-3">
        <!-- Rendered by JS -->
      </div>

      <!-- Modal Footer -->
      <div id="proxy-inspect-footer" class="flex items-center gap-2 pt-2 border-t border-[#2C2723]">
        <!-- Action buttons rendered dynamically -->
      </div>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- JAVASCRIPT APP LOGIC & REALTIME SYNC                      -->
  <!-- ======================================================== -->
  <script>
    let summaryData = null;
    let allCustomers = [];
    let currentTab = 'overview';

    const tabTitles = {
      overview: { title: 'Tổng Quan Bảng Điều Khiển', desc: 'Giám sát tiến trình thời gian thực và đồng bộ 2 chiều', icon: '📊' },
      inbox: { title: 'Hội Thoại Khách Hàng (FB ↔ Telegram)', desc: 'Phòng chat 1-1 độc lập đồng bộ tin nhắn, ảnh và video tức thì', icon: '💬' },
      posts: { title: 'Topic 1: Quản Lý Đăng Bài & Lịch Phân Phối', desc: 'Xác nhận 2 bước an toàn, chống bấm lặp, báo cáo kết quả từng nhóm', icon: '📝' },
      autocmt: { title: 'Topic 2: Bình Luận & Quét Bài Viết', desc: 'Hậu kiểm DOM xác minh nội dung bình luận đã xuất hiện công khai', icon: '🎯' },
      growth: { title: 'Topic 3-5: Quét Thành Viên, Kết Bạn & Tương Tác', desc: 'Điều hành tự động hóa tương tác Facebook chuyên nghiệp', icon: '👥' },
      accounts: { title: 'Quản Lý Tài Khoản & Proxy Riêng Biệt', desc: 'Hồ sơ Chrome độc lập cách ly session chống checkpoint', icon: '🛡️' },
      logs: { title: 'Terminal Giám Sát Tiến Trình (Realtime Log)', desc: 'Nhật ký sự kiện từ lõi FalconX Autonomous Engine', icon: '💻' }
    };

    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function switchTab(tabId) {
      currentTab = tabId;
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      const activeEl = document.getElementById(`tab-${tabId}`);
      if (activeEl) activeEl.classList.remove('hidden');

      document.querySelectorAll('.nav-item').forEach(btn => {
        btn.className = 'nav-item w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition text-[#A8A29E] hover:text-[#FAF7F2] hover:bg-[#24201C]';
      });
      const activeBtn = document.getElementById(`nav-btn-${tabId}`);
      if (activeBtn) {
        activeBtn.className = 'nav-item w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition bg-[#D96B43]/15 text-[#FAF7F2] border border-[#D96B43]/30 shadow-sm';
      }

      const meta = tabTitles[tabId] || tabTitles.overview;
      document.getElementById('section-title').innerHTML = `<span>${meta.icon}</span> <span class="tracking-tight">${meta.title}</span>`;
      document.getElementById('section-desc').textContent = meta.desc;

      if (tabId === 'posts') {
        loadGroupPostingHealth();
      }
      if (tabId === 'autocmt') {
        loadInventoryProperties();
      }
    }

    function formatUptime(seconds) {
      const s = Math.floor(seconds || 0);
      const h = Math.floor(s / 3600);
      const m = Math.floor((s % 3600) / 60);
      const sec = s % 60;
      return `${h}h ${m}m ${sec}s`;
    }

    async function refreshData() {
      const icon = document.getElementById('refresh-icon');
      if (icon) icon.classList.add('animate-spin');

      try {
        const [sumRes, custRes] = await Promise.all([
          fetch('/api/executive-summary').then(r => r.json()),
          fetch('/api/mappings').then(r => r.json())
        ]);

        summaryData = sumRes;
        allCustomers = custRes || [];

        const activeAcc = sumRes.accounts.items.find(a => a.isDefault) || sumRes.accounts.items[0];
        if (activeAcc) {
          document.getElementById('sidebar-name').textContent = activeAcc.name;
          document.getElementById('sidebar-uid').textContent = `UID: ${activeAcc.uid || activeAcc.id}`;
          if (activeAcc.avatar) document.getElementById('sidebar-avatar').src = activeAcc.avatar;
          document.getElementById('kpi-proxy-desc').textContent = activeAcc.proxy ? `Proxy: ${activeAcc.proxy}` : 'Chạy IP Trực Tiếp';

          const briefEl = document.getElementById('sidebar-proxy-brief');
          if (briefEl) {
            if (activeAcc.proxy) {
              const displayProxy = activeAcc.proxy.includes('@') ? activeAcc.proxy.split('@')[1] : activeAcc.proxy;
              briefEl.innerHTML = `<span class="text-emerald-400 font-bold">🟢 Đã bọc Proxy:</span> <span class="text-[#FAF7F2] font-mono">${displayProxy}</span>`;
            } else {
              briefEl.innerHTML = `<span class="text-amber-400 font-bold">⚠️ Chưa có Proxy</span> <span class="text-[#78716C]">(IP máy)</span>`;
            }
          }
        }

        document.getElementById('kpi-live-accounts').textContent = sumRes.accounts.live;
        document.getElementById('kpi-customers-count').textContent = allCustomers.length;
        document.getElementById('sidebar-badge-customers').textContent = allCustomers.length;
        const postsCount = sumRes.dailyPosts?.total ?? (Array.isArray(sumRes.dailyPosts) ? sumRes.dailyPosts.length : (sumRes.dailyPosts?.items?.length || 0));
        document.getElementById('kpi-posts-count').textContent = postsCount;
        document.getElementById('sidebar-badge-posts').textContent = postsCount;

        const isAuto = sumRes.autoComment && sumRes.autoComment.enabled;
        document.getElementById('kpi-autocmt-status').textContent = isAuto ? 'ON' : 'OFF';
        document.getElementById('kpi-groups-count').textContent = `${(sumRes.autoComment && sumRes.autoComment.groupsCount) || 0} Nhóm`;

        renderCustomersList();
        renderDailyPostsList();
        renderAccountsList();
        renderAutoCommentSection();
        populateSavedGroupsDropdown();
        loadGroupPostingHealth();
        loadInventoryProperties();

        fetch('/api/status').then(r => r.json()).then(st => {
          document.getElementById('sidebar-uptime').textContent = formatUptime(st.uptime);
          if (st.telegramBot) document.getElementById('sidebar-bot-tag').textContent = st.telegramBot;
        }).catch(() => {});

      } catch (err) {
        console.warn('Lỗi refresh:', err);
      } finally {
        if (icon) icon.classList.remove('animate-spin');
      }
    }

    function renderCustomersList() {
      const container = document.getElementById('customers-cards-container');
      if (!container) return;
      document.getElementById('cust-count-badge').textContent = allCustomers.length;

      if (allCustomers.length === 0) {
        container.innerHTML = '<div class="col-span-full py-14 text-center text-[#A8A29E] text-xs">Chưa có cuộc trò chuyện nào đồng bộ.</div>';
        return;
      }

      const tagBadges = {
        chot_don: '<span class="text-[9px] bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 px-2 py-0.5 rounded-full font-mono font-bold">🏷️ ĐÃ CHỐT</span>',
        hoi_gia: '<span class="text-[9px] bg-amber-500/15 text-amber-300 border border-amber-500/30 px-2 py-0.5 rounded-full font-mono font-bold">⏳ HỎI GIÁ</span>',
        vip: '<span class="text-[9px] bg-[#D96B43]/20 text-[#E87A5D] border border-[#D96B43]/30 px-2 py-0.5 rounded-full font-mono font-bold">⭐ VIP</span>',
        khach_huy: '<span class="text-[9px] bg-rose-500/15 text-rose-300 border border-rose-500/30 px-2 py-0.5 rounded-full font-mono font-bold">❌ HỦY</span>',
      };

      container.innerHTML = allCustomers.map(c => `
        <div class="claude-card p-4 rounded-3xl flex items-center justify-between gap-3.5 transition">
          <div class="flex items-center gap-3.5 min-w-0">
            <img src="${c.customer_avatar || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(c.customer_name) + '&background=D96B43&color=fff'}" class="w-10 h-10 rounded-2xl object-cover border border-[#3E3832] shadow flex-shrink-0" />
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold text-[#FAF7F2] truncate">${escapeHtml(c.customer_name)}</span>
                ${c.tag && tagBadges[c.tag] ? tagBadges[c.tag] : ''}
              </div>
              <div class="text-[10px] text-[#A8A29E] font-mono mt-0.5">Topic: <b class="text-[#E87A5D]">#${c.telegram_topic_id}</b> · ID: ${c.fb_thread_id.substring(0, 10)}...</div>
            </div>
          </div>
          <div class="flex items-center gap-1.5 flex-shrink-0">
            <a href="https://www.facebook.com/messages/t/${c.fb_thread_id}" target="_blank" rel="noopener noreferrer" class="text-xs bg-[#1877F2]/15 hover:bg-[#1877F2]/25 text-[#4599FF] px-2.5 py-1.5 rounded-xl border border-[#1877F2]/30 font-semibold transition whitespace-nowrap flex items-center gap-1" title="Mở trực tiếp trên Facebook Messenger">
              <span>💬 FB ↗</span>
            </a>
            <a href="https://web.telegram.org" target="_blank" rel="noopener noreferrer" class="text-xs bg-[#D96B43]/15 hover:bg-[#D96B43]/25 text-[#E87A5D] px-2.5 py-1.5 rounded-xl border border-[#D96B43]/30 font-semibold transition whitespace-nowrap" title="Mở phòng chat trên Telegram">
              Tele ↗
            </a>
          </div>
        </div>
      `).join('');
    }

    function filterCustomerList() {
      const q = (document.getElementById('cust-filter-input').value || '').toLowerCase();
      const filtered = allCustomers.filter(c => 
        (c.customer_name && c.customer_name.toLowerCase().includes(q)) ||
        (c.fb_thread_id && c.fb_thread_id.includes(q)) ||
        (String(c.telegram_topic_id).includes(q))
      );
      const container = document.getElementById('customers-cards-container');
      if (filtered.length === 0) {
        container.innerHTML = '<div class="col-span-full py-10 text-center text-[#A8A29E] text-xs">Không tìm thấy khách hàng khớp từ khóa.</div>';
        return;
      }
      container.innerHTML = filtered.map(c => `
        <div class="claude-card p-4 rounded-3xl flex items-center justify-between gap-3.5">
          <div class="flex items-center gap-3.5 min-w-0">
            <img src="${c.customer_avatar || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(c.customer_name) + '&background=D96B43&color=fff'}" class="w-10 h-10 rounded-2xl object-cover border border-[#3E3832] shadow flex-shrink-0" />
            <div class="min-w-0">
              <span class="text-xs font-bold text-[#FAF7F2] truncate block">${escapeHtml(c.customer_name)}</span>
              <span class="text-[10px] text-[#A8A29E] font-mono">Topic: #${c.telegram_topic_id}</span>
            </div>
          </div>
          <div class="flex items-center gap-1.5 flex-shrink-0">
            <a href="https://www.facebook.com/messages/t/${c.fb_thread_id}" target="_blank" rel="noopener noreferrer" class="text-xs bg-[#1877F2]/15 hover:bg-[#1877F2]/25 text-[#4599FF] px-2.5 py-1.5 rounded-xl border border-[#1877F2]/30 font-semibold transition whitespace-nowrap flex items-center gap-1">
              <span>💬 FB ↗</span>
            </a>
            <a href="https://web.telegram.org" target="_blank" rel="noopener noreferrer" class="text-xs bg-[#D96B43]/15 hover:bg-[#D96B43]/25 text-[#E87A5D] px-2.5 py-1.5 rounded-xl border border-[#D96B43]/30 font-semibold transition whitespace-nowrap">
              Tele ↗
            </a>
          </div>
        </div>
      `).join('');
    }

    // ========================================================
    // QUẢN LÝ DẠNG BÀI ĐĂNG & KHO GROUP POSTING HEALTH (TOPIC 1)
    // ========================================================
    let currentPostFilter = 'all';
    let cachedGroupsHealth = [];
    let currentGroupFilter = 'all';

    function filterPostsType(type) {
      currentPostFilter = type;
      document.querySelectorAll('.post-filter-btn').forEach(b => {
        b.className = 'post-filter-btn px-2.5 py-1 rounded-lg text-[11px] font-semibold text-[#A8A29E] hover:text-[#FAF7F2]';
      });
      const activeBtn = document.getElementById(`btn-post-filter-${type}`);
      if (activeBtn) {
        activeBtn.className = 'post-filter-btn px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-[#24201C] text-[#FAF7F2] border border-[#3E3832]';
      }
      renderDailyPostsList();
    }

    function renderDailyPostsList() {
      const container = document.getElementById('posts-list-container');
      if (!container || !summaryData) return;
      let posts = Array.isArray(summaryData.dailyPosts) ? summaryData.dailyPosts : (summaryData.dailyPosts?.items || []);

      // Lọc theo dạng bài
      if (currentPostFilter === 'personal_post') {
        posts = posts.filter(p => (p.targetType || p.type) === 'personal_post');
      } else if (currentPostFilter === 'group_post') {
        posts = posts.filter(p => (p.targetType || p.type) === 'group_post');
      } else if (currentPostFilter === 'both') {
        posts = posts.filter(p => (p.targetType || p.type) === 'both');
      } else if (currentPostFilter === 'pending_approval') {
        posts = posts.filter(p => (p.receipts || []).some(r => r.status === 'pending_approval') || p.status === 'pending');
      }

      if (posts.length === 0) {
        container.innerHTML = '<div class="claude-card rounded-3xl py-10 text-center text-[#A8A29E] text-xs">Không có bài đăng nào khớp bộ lọc. Soạn bài ở trên hoặc gửi vào Topic 1 Telegram!</div>';
        return;
      }

      container.innerHTML = posts.map((p, idx) => {
        const statusMap = {
          confirmed: { label: 'Đã Xác Nhận Sẵn Sàng', class: 'bg-emerald-500/15 text-emerald-400 border-emerald-500/30' },
          scheduled: { label: `⏰ Đã Lên Lịch (${p.scheduledTime || ''})`, class: 'bg-[#F59E0B]/15 text-[#F59E0B] border-[#F59E0B]/30' },
          running: { label: '🚀 Đang Xuất Bản Thật...', class: 'bg-[#D96B43]/15 text-[#E87A5D] border-[#D96B43]/30 animate-pulse' },
          completed: { label: '🎉 Đã Hoàn Thành Toàn Bộ', class: 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30' },
          failed: { label: '❌ Thất Bại', class: 'bg-rose-500/15 text-rose-400 border-rose-500/30' },
          pending: { label: '⏳ Chờ Xác Nhận', class: 'bg-amber-500/15 text-amber-400 border-amber-500/30' },
        };
        const st = statusMap[p.status] || statusMap.pending;

        // Bóc tách receipts từng đích
        let receiptsHtml = '';
        if (p.receipts && p.receipts.length > 0) {
          receiptsHtml = `
            <div class="pt-2 border-t border-[#25211D] space-y-1.5">
              <span class="text-[10px] font-mono text-[#A8A29E] uppercase tracking-wider block">Báo Cáo Chi Tiết Đích Đến:</span>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px]">
                ${p.receipts.map(r => {
                  const isSuccess = r.status === 'verified_success';
                  const isPending = r.status === 'pending_approval';
                  const badgeClass = isSuccess ? 'bg-emerald-500/15 text-emerald-400 border-emerald-500/30' : isPending ? 'bg-amber-500/15 text-amber-400 border-amber-500/30' : 'bg-rose-500/15 text-rose-400 border-rose-500/30';
                  const badgeText = isSuccess ? '✅ Thành công' : isPending ? '⏳ Chờ Admin duyệt' : '❌ Lỗi';
                  return `
                    <div class="p-2.5 rounded-xl bg-[#141210] border border-[#2A2622] flex items-center justify-between gap-2">
                      <div class="min-w-0">
                        <div class="font-bold text-[#FAF7F2] truncate flex items-center gap-1.5">
                          <span class="px-2 py-0.5 rounded text-[10px] font-mono border ${badgeClass}">${badgeText}</span>
                          <span class="truncate" title="${escapeHtml(r.target)}">${escapeHtml(r.target)}</span>
                        </div>
                        ${r.error ? `<div class="text-[10px] text-rose-400 truncate mt-0.5">${escapeHtml(r.error)}</div>` : ''}
                      </div>
                      ${r.postUrl ? `
                        <a href="${escapeHtml(r.postUrl)}" target="_blank" rel="noopener noreferrer" class="text-[11px] text-[#4599FF] hover:underline flex-shrink-0 font-semibold flex items-center gap-1">
                          <span>Link ↗</span>
                        </a>
                      ` : ''}
                    </div>
                  `;
                }).join('')}
              </div>
            </div>
          `;
        }

        return `
          <div class="claude-card rounded-3xl p-5 space-y-3.5 transition border border-[#2E2925] bg-[#171412]">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span class="text-xs font-mono font-bold text-[#A8A29E]">#${idx + 1}</span>
                <span class="text-[11px] px-3 py-0.5 rounded-full border font-semibold ${st.class}">${st.label}</span>
                <span class="text-[11px] text-[#A8A29E] font-mono">${new Date(p.createdAt).toLocaleTimeString('vi-VN')}</span>
              </div>
              <div class="flex items-center gap-2">
                ${p.status !== 'completed' && p.status !== 'running' ? `
                  <button onclick="runPostNow('${p.id}')" class="text-xs bg-[#D96B43] hover:bg-[#E27D56] text-white font-bold px-3 py-1 rounded-xl transition shadow-md shadow-[#D96B43]/20">
                    ▶️ Đăng Ngay
                  </button>
                ` : ''}
                <button onclick="deletePostFromWeb('${p.id}')" class="text-xs text-[#A8A29E] hover:text-rose-400 px-2 py-1 rounded-lg transition" title="Xóa bài đăng này">
                  🗑️
                </button>
              </div>
            </div>

            <p class="text-xs text-[#FAF7F2] leading-relaxed font-sans bg-[#120F0D] p-3.5 rounded-2xl border border-[#25211D]">
              ${escapeHtml(p.content)}
            </p>

            <div class="flex items-center justify-between text-[11px] text-[#A8A29E] font-mono pt-1">
              <span>Đích: ${p.type === 'personal_post' ? '👤 Trang cá nhân' : p.type === 'both' ? '⚡ Cá nhân & Group' : '🌐 Group mục tiêu'}</span>
              <span>${p.mediaUrls && p.mediaUrls.length ? `🖼️ ${p.mediaUrls.length} file ảnh` : 'Văn bản thuần'}</span>
            </div>

            ${receiptsHtml}
          </div>
        `;
      }).join('');
    }

    // ========================================================
    // QUẢN LÝ KHO GROUP & NOTE LƯU Ý SỨC KHỎE (GROUP HEALTH & NOTES)
    // ========================================================
    async function loadGroupPostingHealth() {
      try {
        const res = await fetch('/api/groups/posting-health').then(r => r.json());
        if (!res.success) return;
        cachedGroupsHealth = res.groups || [];
        const stats = res.stats || {};

        // Update KPIs
        document.getElementById('group-stat-total').textContent = stats.total || 0;
        document.getElementById('group-stat-direct').textContent = stats.directSuccess || 0;
        document.getElementById('group-stat-pending').textContent = stats.pendingApproval || 0;
        document.getElementById('group-stat-failed').textContent = stats.failedOrRestricted || 0;

        renderGroupHealthTable(cachedGroupsHealth);
      } catch (err) {
        console.error('Lỗi tải Group Health:', err);
      }
    }

    function filterGroupHealthTable(filterType) {
      currentGroupFilter = filterType;
      document.querySelectorAll('.group-filter-btn').forEach(b => {
        b.className = 'group-filter-btn px-2.5 py-1 rounded-lg text-[11px] font-semibold text-[#A8A29E] hover:text-[#FAF7F2]';
      });
      const activeBtn = document.getElementById(`btn-grp-filter-${filterType}`);
      if (activeBtn) {
        activeBtn.className = 'group-filter-btn px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-[#24201C] text-[#FAF7F2] border border-[#3E3832]';
      }

      let filtered = cachedGroupsHealth;
      if (filterType === 'direct') {
        filtered = cachedGroupsHealth.filter(g => g.postingStatus === 'direct_success');
      } else if (filterType === 'pending') {
        filtered = cachedGroupsHealth.filter(g => g.postingStatus === 'pending_approval');
      } else if (filterType === 'failed') {
        filtered = cachedGroupsHealth.filter(g => g.postingStatus === 'failed' || g.postingStatus === 'restricted' || (g.postFailCount && g.postFailCount > 0));
      }
      renderGroupHealthTable(filtered);
    }

    function renderGroupHealthTable(groups) {
      const tbody = document.getElementById('groups-health-tbody');
      if (!tbody) return;

      if (!groups || groups.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="6" class="py-8 text-center text-[#A8A29E] text-xs">
              Chưa có Group nào trong danh sách. Hãy bấm "➕ Thêm Group Mới" hoặc "🔄 Đồng Bộ Group Đã Tham Gia"!
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = groups.map((g, idx) => {
        // Status badge
        let badgeHtml = '<span class="px-2.5 py-1 rounded-full text-[10px] font-semibold bg-stone-500/15 text-stone-300 border border-stone-500/30">⚪ Mới / Chưa test</span>';
        if (g.postingStatus === 'direct_success') {
          badgeHtml = '<span class="px-2.5 py-1 rounded-full text-[10px] font-semibold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 flex items-center gap-1 w-max">🟢 Đăng tốt (Direct)</span>';
        } else if (g.postingStatus === 'pending_approval') {
          badgeHtml = '<span class="px-2.5 py-1 rounded-full text-[10px] font-semibold bg-amber-500/15 text-amber-400 border border-amber-500/30 flex items-center gap-1 w-max">⏳ Chờ Admin duyệt</span>';
        } else if (g.postingStatus === 'failed' || g.postingStatus === 'restricted') {
          badgeHtml = '<span class="px-2.5 py-1 rounded-full text-[10px] font-semibold bg-rose-500/15 text-rose-400 border border-rose-500/30 flex items-center gap-1 w-max">🔴 Thường lỗi / Chặn</span>';
        }

        const noteText = g.postNotes || (g.lastPostError ? `⚠️ ${g.lastPostError}` : 'Chưa có ghi chú đặc thù');
        const isNoteAlert = g.postingStatus === 'failed' || /lỗi|chặn|không|chưa/i.test(noteText);

        const isActive = g.status === 'active';
        const successCount = g.postSuccessCount || 0;
        const failCount = g.postFailCount || 0;

        return `
          <tr class="hover:bg-[#1C1815] transition">
            <td class="py-3 px-3.5 min-w-[200px]">
              <div class="font-bold text-[#FAF7F2] truncate flex items-center gap-1.5" title="${escapeHtml(g.name || g.url)}">
                <span class="text-xs font-mono text-[#A8A29E]">#${idx + 1}</span>
                <span class="truncate">${escapeHtml(g.name || 'Group Facebook')}</span>
              </div>
              <a href="${escapeHtml(g.url)}" target="_blank" rel="noopener noreferrer" class="text-[10px] text-[#4599FF] hover:underline font-mono truncate block mt-0.5">
                ${escapeHtml(g.url)}
              </a>
            </td>

            <td class="py-3 px-3 whitespace-nowrap">
              ${badgeHtml}
              ${g.lastPostAt ? `<div class="text-[9px] text-[#A8A29E] font-mono mt-1">Lần cuối: ${new Date(g.lastPostAt).toLocaleDateString('vi-VN')}</div>` : ''}
            </td>

            <td class="py-3 px-3 max-w-[280px]">
              <div class="flex items-center justify-between gap-2 p-2 rounded-xl bg-[#171412] border ${isNoteAlert ? 'border-rose-500/30 bg-rose-500/5' : 'border-[#2A2622]'} group/note">
                <span class="text-[11px] ${isNoteAlert ? 'text-rose-300 font-medium' : 'text-[#D6D3D1]'} truncate block" title="${escapeHtml(noteText)}">
                  ${escapeHtml(noteText)}
                </span>
                <button onclick="editGroupNotePrompt('${g.id}', '${escapeHtml(noteText)}')" class="text-[10px] text-[#D96B43] hover:underline flex-shrink-0 font-bold opacity-80 group-hover/note:opacity-100 transition" title="Chỉnh sửa ghi chú">
                  ✏️ Sửa Note
                </button>
              </div>
            </td>

            <td class="py-3 px-3 text-center whitespace-nowrap font-mono text-[11px]">
              <span class="text-emerald-400 font-bold" title="Số lần đăng thành công">✅ ${successCount}</span>
              <span class="text-[#A8A29E] mx-1">|</span>
              <span class="text-rose-400 font-bold" title="Số lần thất bại">❌ ${failCount}</span>
            </td>

            <td class="py-3 px-3 text-center whitespace-nowrap">
              <button onclick="toggleGroupActive('${g.id}')" class="px-2.5 py-1 rounded-xl text-[10px] font-bold border transition ${isActive ? 'bg-emerald-500/15 text-emerald-400 border-emerald-500/30 hover:bg-emerald-500/25' : 'bg-stone-500/15 text-stone-400 border-stone-500/30 hover:bg-stone-500/25'}">
                ${isActive ? '🟢 Sẵn sàng' : '⏸️ Tạm dừng'}
              </button>
            </td>

            <td class="py-3 px-3 text-right whitespace-nowrap">
              <button onclick="selectSingleGroupForComposer('${escapeHtml(g.url)}')" class="text-[11px] px-2.5 py-1 rounded-xl bg-[#24201C] hover:bg-[#2C2723] text-[#FAF7F2] border border-[#3E3832] font-semibold transition" title="Chọn đăng thử vào riêng nhóm này">
                ⚡ Đăng thử
              </button>
            </td>
          </tr>
        `;
      }).join('');
    }

    async function editGroupNotePrompt(groupId, currentNote) {
      const newNote = prompt('Nhập lưu ý / ghi chú mới cho Group này (VD: "Chờ Admin duyệt", "Bị chặn bán hàng", "Đăng tốt"):', currentNote === 'Chưa có ghi chú đặc thù' ? '' : currentNote);
      if (newNote === null) return;
      try {
        const res = await fetch(`/api/groups/${groupId}/note`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ postNotes: newNote.trim() })
        }).then(r => r.json());
        if (res.success) {
          await loadGroupPostingHealth();
          alert('✅ Đã cập nhật ghi chú cho Group thành công!');
        } else {
          alert('Lỗi: ' + res.error);
        }
      } catch (err) {
        alert('Lỗi kết nối: ' + err.message);
      }
    }

    async function toggleGroupActive(groupId) {
      try {
        const res = await fetch(`/api/groups/${groupId}/toggle`, {
          method: 'POST'
        }).then(r => r.json());
        if (res.success) {
          await loadGroupPostingHealth();
          toggleGroupSelectionUI();
        } else {
          alert('Lỗi: ' + res.error);
        }
      } catch (err) {
        alert('Lỗi kết nối: ' + err.message);
      }
    }

    function selectSingleGroupForComposer(groupUrl) {
      const radioGroup = document.querySelector('input[name="web-post-target"][value="group_post"]');
      if (radioGroup) {
        radioGroup.checked = true;
        toggleGroupSelectionUI();
      }
      setTimeout(() => {
        document.querySelectorAll('input[name="post-target-group"]').forEach(cb => {
          cb.checked = (cb.value === groupUrl);
        });
        document.getElementById('web-post-content')?.focus();
        document.getElementById('tab-posts')?.scrollIntoView({ behavior: 'smooth' });
      }, 300);
    }

    async function syncJoinedGroups() {
      if (!confirm('Hệ thống sẽ mở tài khoản Eco Trang quét lại các nhóm Facebook đã tham gia (Joined) và tự động cập nhật vào Kho Group. Bắt đầu ngay?')) return;
      try {
        const res = await fetch('/api/groups/sync-joined', { method: 'POST' }).then(r => r.json());
        if (res.success) {
          alert(`🎉 Đồng bộ thành công! Tìm thấy ${res.joinedCount} Group đã tham gia trong tổng số ${res.totalPool} Group.`);
          await loadGroupPostingHealth();
        } else {
          alert('Lỗi đồng bộ: ' + (res.error || 'Không xác định'));
        }
      } catch (err) {
        alert('Lỗi kết nối: ' + err.message);
      }
    }

    function openAddNewGroupModal() {
      const url = prompt('Nhập đường dẫn Group Facebook cần thêm (VD: https://www.facebook.com/groups/ecopark...):');
      if (!url || !url.trim()) return;
      const name = prompt('Nhập tên gợi nhớ của Group (tùy chọn):', '') || '';
      fetch('/api/autocmt/groups', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url: url.trim(), name: name.trim() })
      }).then(r => r.json()).then(res => {
        if (res.success) {
          alert('✅ Đã thêm Group mới vào Kho thành công!');
          loadGroupPostingHealth();
        } else {
          alert('Lỗi: ' + res.error);
        }
      }).catch(e => alert('Lỗi kết nối: ' + e.message));
    }

    // ========================================================
    // QUẢN LÝ KHO NGUỒN BĐS & QUỸ CĂN TRONG NGÀY (INVENTORY)
    // ========================================================
    let allProperties = [];
    let currentInvFilter = 'all';
    let selectedInvImageBase64 = null;

    async function loadInventoryProperties() {
      try {
        const res = await fetch('/api/properties').then(r => r.json());
        if (!res.success) return;

        allProperties = res.properties || [];
        const stats = res.stats || {};

        const totalEl = document.getElementById('inv-kpi-total');
        if (totalEl) totalEl.textContent = stats.total || 0;
        const availEl = document.getElementById('inv-kpi-available');
        if (availEl) availEl.textContent = stats.availableCount || 0;
        const rentEl = document.getElementById('inv-kpi-rent');
        if (rentEl) rentEl.textContent = stats.rentCount || 0;
        const saleEl = document.getElementById('inv-kpi-sale');
        if (saleEl) saleEl.textContent = stats.saleCount || 0;

        const topicId = res.config?.telegramInventoryTopicId || res.config?.telegramTopicId || 67;
        const topicEl = document.getElementById('inv-topic-display');
        if (topicEl) topicEl.textContent = `Topic #${topicId} (Telegram)`;

        renderInventoryTable(currentInvFilter);
      } catch (err) {
        console.warn('Lỗi tải kho nguồn BĐS:', err);
      }
    }

    function renderInventoryTable(filter = 'all') {
      currentInvFilter = filter;
      const tbody = document.getElementById('inv-properties-tbody');
      if (!tbody) return;

      let filtered = allProperties;
      if (filter === 'available') filtered = allProperties.filter(p => p.status === 'available');
      else if (filter === 'rent') filtered = allProperties.filter(p => p.type === 'rent');
      else if (filter === 'sale') filtered = allProperties.filter(p => p.type === 'sale');
      else if (filter === 'done') filtered = allProperties.filter(p => p.status === 'done');

      const countEl = document.getElementById('inv-table-count');
      if (countEl) countEl.textContent = `Hiển thị: ${filtered.length} / ${allProperties.length} căn`;

      if (filtered.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="8" class="py-6 text-center text-[#78716C] text-xs">
              Chưa có căn hộ nào khớp bộ lọc hiện tại.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = filtered.map(p => {
        const isAvail = p.status === 'available';
        const isRent = p.type === 'rent';
        return `
          <tr class="hover:bg-[#1E1B18] transition group">
            <td class="py-3 px-3">
              <div class="flex items-center gap-2">
                <span class="text-base">${isRent ? '🔑' : '🏷️'}</span>
                <div>
                  <span class="font-bold text-[#FAF7F2] text-xs block">${escapeHtml(p.project)} - <span class="text-[#D96B43]">${escapeHtml(p.bedroom)}</span></span>
                  <span class="text-[10px] text-[#78716C] font-mono truncate max-w-[200px] block" title="${escapeHtml(p.rawText)}">${escapeHtml(p.rawText)}</span>
                </div>
              </div>
            </td>
            <td class="py-3 px-3 whitespace-nowrap">
              <span class="text-[11px] text-[#D6D3D1] block flex items-center gap-1 font-medium">
                <span>📍</span> ${escapeHtml(p.cluster || 'Ecopark')}
              </span>
              <span class="text-[9px] text-[#78716C] font-mono">Radar GPS Haversine</span>
            </td>
            <td class="py-3 px-3 text-center whitespace-nowrap">
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold border ${isRent ? 'bg-sky-500/15 text-sky-400 border-sky-500/30' : 'bg-amber-500/15 text-amber-400 border-amber-500/30'}">
                ${isRent ? 'Cho thuê' : 'Bán'}
              </span>
            </td>
            <td class="py-3 px-3 text-center whitespace-nowrap font-mono text-xs font-semibold text-emerald-400">
              ${escapeHtml(p.areaText || (p.area ? p.area + 'm²' : '—'))}
            </td>
            <td class="py-3 px-3 text-right whitespace-nowrap font-mono font-bold text-xs text-[#FAF7F2]">
              ${escapeHtml(p.priceText)}
            </td>
            <td class="py-3 px-3 whitespace-nowrap text-xs text-[#D6D3D1]">
              ${escapeHtml(p.furniture)}
            </td>
            <td class="py-3 px-3 whitespace-nowrap font-mono text-[11px] text-[#A8A29E]">
              ${p.phone ? `<a href="tel:${escapeHtml(p.phone)}" class="text-emerald-400 hover:underline">📞 ${escapeHtml(p.phone)}</a>` : '<span class="text-[#57534E]">Chưa có</span>'}
            </td>
            <td class="py-3 px-3 text-center whitespace-nowrap font-mono text-xs">
              <span class="px-2 py-0.5 rounded-full bg-[#24201C] text-[#FAF7F2] border border-[#3E3832]" title="Số lần Bot đã tự động bắt khách cho căn này">
                💬 ${p.matchedPostsCount || 0}
              </span>
            </td>
            <td class="py-3 px-3 text-center whitespace-nowrap">
              <button onclick="togglePropertyStatusUI('${p.id}')" class="px-2.5 py-1 rounded-xl text-[10px] font-bold border transition ${isAvail ? 'bg-emerald-500/15 text-emerald-400 border-emerald-500/30 hover:bg-emerald-500/25' : 'bg-stone-500/15 text-stone-400 border-stone-500/30 hover:bg-stone-500/25'}">
                ${isAvail ? '🟢 Đang săn' : '✅ Đã chốt'}
              </button>
            </td>
            <td class="py-3 px-3 text-center whitespace-nowrap">
              <button onclick="deletePropertyUI('${p.id}')" class="text-[11px] text-rose-400 hover:text-rose-300 font-bold opacity-80 hover:opacity-100 transition" title="Xóa căn">
                🗑️
              </button>
            </td>
          </tr>
        `;
      }).join('');
    }

    function filterInventoryTable(filter) {
      document.querySelectorAll('.inv-flt-btn').forEach(btn => {
        btn.className = 'inv-flt-btn text-[11px] font-bold px-3 py-1 rounded-xl text-[#A8A29E] hover:text-white transition';
      });
      const activeBtn = document.getElementById(`btn-inv-flt-${filter}`);
      if (activeBtn) {
        activeBtn.className = 'inv-flt-btn text-[11px] font-bold px-3 py-1 rounded-xl bg-[#D96B43]/15 text-[#FAF7F2] border border-[#D96B43]/30 transition';
      }
      renderInventoryTable(filter);
    }

    async function scanAndAddPropertiesFromText() {
      const txt = document.getElementById('inv-input-text').value.trim();
      if (!txt) return alert('Vui lòng nhập hoặc dán nội dung tin nhắn căn hộ!');

      const btn = document.getElementById('btn-scan-text');
      btn.disabled = true;
      btn.innerHTML = '<span>⏳</span> <span>Đang bóc tách...</span>';

      try {
        const res = await fetch('/api/properties/scan-text', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text: txt })
        }).then(r => r.json());

        if (res.success) {
          alert(`✅ Đã bóc tách và nạp thành công ${res.count} căn vào Kho Nguồn!`);
          document.getElementById('inv-input-text').value = '';
          await loadInventoryProperties();
        } else {
          alert('Lỗi: ' + res.error);
        }
      } catch (err) {
        alert('Lỗi kết nối: ' + err.message);
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<span>⚡</span> <span>Bóc Tách & Nạp Căn</span>';
      }
    }

    let selectedInvImagesBase64 = [];

    function previewInventoryImage(e) {
      const files = Array.from(e.target.files || []).filter(f => f.type.startsWith('image/') || /\.(jpg|jpeg|png|webp)$/i.test(f.name));
      if (files.length === 0) return;
      handleSelectedFiles(files);
    }

    function previewInventoryFolder(e) {
      const files = Array.from(e.target.files || []).filter(f => f.type.startsWith('image/') || /\.(jpg|jpeg|png|webp)$/i.test(f.name));
      if (files.length === 0) return alert('Không tìm thấy file ảnh nào trong folder đã chọn.');
      handleSelectedFiles(files, true);
    }

    function handleSelectedFiles(files, isFolder = false) {
      selectedInvImagesBase64 = [];
      document.getElementById('inv-file-name').textContent = isFolder
        ? `Đã chọn Folder (${files.length} ảnh căn hộ)`
        : `Đã chọn ${files.length} ảnh căn hộ`;
      document.getElementById('inv-ocr-status').textContent = 'Bấm "Quét Chữ OCR & Nạp" để phân loại';

      files.forEach(file => {
        const reader = new FileReader();
        reader.onload = (ev) => {
          selectedInvImagesBase64.push({ name: file.name, base64: ev.target.result });
        };
        reader.readAsDataURL(file);
      });
    }

    async function scanAndAddPropertiesFromImage() {
      if (selectedInvImagesBase64.length === 0) {
        return alert('Vui lòng chọn ảnh hoặc folder ảnh bảng hàng trước!');
      }

      const btn = document.getElementById('btn-scan-image');
      const st = document.getElementById('inv-ocr-status');
      btn.disabled = true;
      btn.innerHTML = '<span>⏳</span> <span>Tesseract OCR...</span>';
      st.textContent = `Đang quét chữ ${selectedInvImagesBase64.length} ảnh (offline)...`;

      let totalAdded = 0;

      try {
        for (let i = 0; i < selectedInvImagesBase64.length; i++) {
          const item = selectedInvImagesBase64[i];
          st.textContent = `Đang đọc ảnh ${i + 1}/${selectedInvImagesBase64.length}: ${item.name}...`;

          const res = await fetch('/api/properties/scan-image', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ imageBase64: item.base64 })
          }).then(r => r.json());

          if (res.success) {
            totalAdded += res.count || 0;
          }
        }

        alert(`📸 ĐÃ QUÉT XONG ${selectedInvImagesBase64.length} ẢNH!\n\nNhận diện và nạp thành công: ${totalAdded} căn vào Kho Nguồn.`);
        selectedInvImagesBase64 = [];
        document.getElementById('inv-input-file').value = '';
        document.getElementById('inv-input-folder').value = '';
        document.getElementById('inv-file-name').textContent = 'Bấm để chọn nhiều ảnh hoặc kéo thả vào đây';
        st.textContent = `Đã nạp xong ${totalAdded} căn.`;
        await loadInventoryProperties();
      } catch (err) {
        alert('Lỗi xử lý OCR: ' + err.message);
        st.textContent = 'Lỗi kết nối.';
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<span>🔍</span> <span>Quét Chữ OCR & Nạp</span>';
      }
    }

    async function togglePropertyStatusUI(id) {
      try {
        const res = await fetch(`/api/properties/${id}/toggle`, { method: 'POST' }).then(r => r.json());
        if (res.success) {
          await loadInventoryProperties();
        } else {
          alert('Lỗi: ' + res.error);
        }
      } catch (e) {
        alert('Lỗi: ' + e.message);
      }
    }

    async function deletePropertyUI(id) {
      if (!confirm('Bạn có chắc chắn muốn xóa căn này khỏi kho nguồn?')) return;
      try {
        const res = await fetch(`/api/properties/${id}`, { method: 'DELETE' }).then(r => r.json());
        if (res.success) {
          await loadInventoryProperties();
        } else {
          alert('Lỗi: ' + res.error);
        }
      } catch (e) {
        alert('Lỗi: ' + e.message);
      }
    }

    async function changeInventoryTopicPrompt() {
      const current = document.getElementById('inv-topic-display').textContent;
      const num = prompt('Nhập Topic ID trên Telegram để nạp căn (VD: 67 hoặc ID topic mới):', current.replace(/[^0-9]/g, ''));
      if (!num) return;
      try {
        const res = await fetch('/api/config/inventory-topic', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ topicId: parseInt(num, 10) })
        }).then(r => r.json());
        if (res.success) {
          alert(`✅ Đã cấu hình Topic #${num} làm Topic nạp căn!`);
          await loadInventoryProperties();
        }
      } catch (e) {
        alert('Lỗi: ' + e.message);
      }
    }

    // ========================================================
    // LOGIC SOẠN & ĐĂNG BÀI TỪ WEB (TOPIC 1 PARITY)
    // ========================================================
    let postSelectedFiles = [];

    function updatePostCharCount() {
      const val = document.getElementById('web-post-content')?.value || '';
      const countEl = document.getElementById('post-char-count');
      if (countEl) countEl.textContent = `${val.length} ký tự`;
    }

    function toggleGroupSelectionUI() {
      const target = document.querySelector('input[name="web-post-target"]:checked')?.value;
      const panel = document.getElementById('web-post-groups-panel');
      if (panel) {
        if (target === 'group_post' || target === 'both') {
          panel.classList.remove('hidden');
          loadPostGroupsCheckboxes();
        } else {
          panel.classList.add('hidden');
        }
      }
    }

    async function loadPostGroupsCheckboxes() {
      const container = document.getElementById('web-post-groups-checkboxes');
      if (!container) return;
      try {
        const res = await fetch('/api/autocmt/data').then(r => r.json());
        const groups = res.groups || [];
        if (groups.length === 0) {
          container.innerHTML = '<span class="text-xs text-[#A8A29E]">Chưa có Group mục tiêu. Hãy thêm bằng lệnh <code>+group &lt;link&gt;</code> trong Telegram!</span>';
          return;
        }
        container.innerHTML = groups.map(g => `
          <label class="flex items-center gap-2 p-2 rounded-xl bg-[#171412] border border-[#2E2925] hover:border-[#D96B43]/40 cursor-pointer">
            <input type="checkbox" name="post-target-group" value="${escapeHtml(g.url)}" checked class="accent-[#D96B43]" />
            <span class="truncate font-medium text-[#FAF7F2]">${escapeHtml(g.name || g.url)}</span>
          </label>
        `).join('');
      } catch {}
    }

    function toggleSelectAllPostGroups() {
      const cbs = document.querySelectorAll('input[name="post-target-group"]');
      const allChecked = Array.from(cbs).every(cb => cb.checked);
      cbs.forEach(cb => cb.checked = !allChecked);
    }

    function handlePostFilesSelect(event) {
      const files = Array.from(event.target.files || []);
      postSelectedFiles = files;
      const summaryEl = document.getElementById('web-post-files-summary');
      const previewContainer = document.getElementById('web-post-previews-container');

      if (files.length === 0) {
        if (summaryEl) summaryEl.textContent = 'Chưa chọn ảnh';
        if (previewContainer) previewContainer.innerHTML = '';
        return;
      }

      if (summaryEl) summaryEl.textContent = `Đã chọn ${files.length} file ảnh`;
      if (previewContainer) {
        previewContainer.innerHTML = '';
        files.forEach(f => {
          const reader = new FileReader();
          reader.onload = (e) => {
            const img = document.createElement('img');
            img.src = e.target.result;
            img.className = 'w-16 h-16 rounded-xl object-cover border border-[#3E3832] shadow';
            previewContainer.appendChild(img);
          };
          reader.readAsDataURL(f);
        });
      }
    }

    function clearPostComposerForm() {
      const contentEl = document.getElementById('web-post-content');
      if (contentEl) contentEl.value = '';
      updatePostCharCount();
      postSelectedFiles = [];
      const fileInput = document.getElementById('web-post-file-input');
      if (fileInput) fileInput.value = '';
      const summaryEl = document.getElementById('web-post-files-summary');
      if (summaryEl) summaryEl.textContent = 'Chưa chọn ảnh';
      const previewContainer = document.getElementById('web-post-previews-container');
      if (previewContainer) previewContainer.innerHTML = '';
      const resultPanel = document.getElementById('web-post-result-panel');
      if (resultPanel) resultPanel.classList.add('hidden');
    }

    function readSelectedPostFilesAsBase64() {
      if (!postSelectedFiles || postSelectedFiles.length === 0) return Promise.resolve([]);
      return Promise.all(
        postSelectedFiles.map(file => new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = (e) => resolve(e.target.result);
          reader.onerror = (err) => reject(err);
          reader.readAsDataURL(file);
        }))
      );
    }

    async function publishPostDirectFromWeb() {
      const content = document.getElementById('web-post-content')?.value?.trim() || '';
      if (!content && (!postSelectedFiles || postSelectedFiles.length === 0)) {
        return alert('Vui lòng nhập nội dung bài viết hoặc chọn ít nhất 1 hình ảnh!');
      }

      const targetType = document.querySelector('input[name="web-post-target"]:checked')?.value || 'personal_post';
      const groupCheckboxes = Array.from(document.querySelectorAll('input[name="post-target-group"]:checked'));
      const groupUrls = groupCheckboxes.map(cb => cb.value);

      if ((targetType === 'group_post' || targetType === 'both') && groupUrls.length === 0) {
        return alert('Vui lòng tích chọn ít nhất 1 Group mục tiêu để đăng bài!');
      }

      const btn = document.getElementById('btn-web-publish-now');
      btn.disabled = true;
      btn.innerHTML = '<span class="w-3 h-3 rounded-full border-2 border-white border-t-transparent animate-spin"></span> <span>ĐANG ĐĂNG LÊN FACEBOOK...</span>';

      logActivity(`[Post] Bắt đầu đăng bài trực tiếp lên Facebook (${targetType}, ${postSelectedFiles.length} ảnh)...`);

      try {
        const photoDataUrls = await readSelectedPostFilesAsBase64();
        const res = await fetch('/api/posts/publish-direct', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content, targetType, groupUrls, photoDataUrls })
        }).then(r => r.json());

        const resultPanel = document.getElementById('web-post-result-panel');
        const resultTitle = document.getElementById('web-post-result-title');
        const resultDesc = document.getElementById('web-post-result-desc');
        const proofImg = document.getElementById('web-post-proof-img');
        const resultTime = document.getElementById('web-post-result-time');

        if (res.success && res.result) {
          resultPanel.classList.remove('hidden');
          resultTitle.textContent = `🎉 ĐÃ XUẤT BẢN THÀNH CÔNG (${res.result.publishedCount}/${res.result.totalTargets} ĐÍCH)!`;
          resultTitle.className = 'text-xs font-bold text-emerald-400';
          resultTime.textContent = new Date().toLocaleTimeString('vi-VN');
          const linksText = (res.result.receipts || [])
            .map(r => r.postUrl ? `• ${r.target}: ${r.postUrl}` : `• ${r.target}`)
            .join(' | ');
          resultDesc.textContent = `Đã xuất bản thành công (${photoDataUrls.length} ảnh). ${linksText || ''}`;

          if (res.result.screenshotPath) {
            proofImg.src = '/api/posts/proof-image?t=' + Date.now();
          }

          logActivity(`[Post] Đăng bài thành công! Xuất bản lên ${res.result.publishedCount} nơi (${photoDataUrls.length} ảnh).`);
          refreshData();
          alert('🎉 Chúc mừng! Bài viết kèm hình ảnh đã được đăng thành công lên Facebook!');
        } else {
          resultPanel.classList.remove('hidden');
          resultTitle.textContent = '❌ ĐĂNG BÀI THẤT BẠI';
          resultTitle.className = 'text-xs font-bold text-rose-400';
          resultDesc.textContent = res.error || res.result?.error || 'Facebook từ chối xuất bản.';
          alert('❌ Đăng bài thất bại: ' + (res.error || 'Vui lòng kiểm tra lại trạng thái Facebook'));
        }
      } catch (err) {
        alert('❌ Lỗi kết nối: ' + err.message);
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<span>⚡ ĐĂNG NGAY LÊN FACEBOOK</span>';
      }
    }

    async function schedulePostFromWeb() {
      const content = document.getElementById('web-post-content')?.value?.trim() || '';
      if (!content && (!postSelectedFiles || postSelectedFiles.length === 0)) {
        return alert('Vui lòng nhập nội dung bài viết hoặc chọn ít nhất 1 hình ảnh!');
      }

      const time = prompt('Nhập giờ bạn muốn lên lịch đăng (VD: 11:30 hoặc 19:30):', '11:30');
      if (!time) return;

      const targetType = document.querySelector('input[name="web-post-target"]:checked')?.value || 'personal_post';
      const groupCheckboxes = Array.from(document.querySelectorAll('input[name="post-target-group"]:checked'));
      const groupUrls = groupCheckboxes.map(cb => cb.value);

      try {
        const photoDataUrls = await readSelectedPostFilesAsBase64();
        const res = await fetch('/api/daily-posts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content, type: targetType, groupUrls, photoDataUrls })
        }).then(r => r.json());

        if (res.success) {
          logActivity(`[Post] Đã thêm bài vào hàng đợi đăng: #${res.post.id} lúc ${time} (${photoDataUrls.length} ảnh)`);
          alert(`⏰ Đã lưu bài (${photoDataUrls.length} ảnh) vào hàng đợi thành công!`);
          clearPostComposerForm();
          refreshData();
        }
      } catch (err) {
        alert('❌ Lỗi: ' + err.message);
      }
    }

    async function deletePostFromWeb(id) {
      if (confirm('Bạn có chắc chắn muốn xóa bài đăng này khỏi hàng đợi không?')) {
        await fetch(`/api/daily-posts/${id}`, { method: 'DELETE' });
        logActivity(`[Post] Đã xóa bài đăng #${id}`);
        refreshData();
      }
    }

    async function clearAllPostsFromWeb() {
      if (confirm('Xác nhận xóa TOÀN BỘ danh sách bài đăng hôm nay?')) {
        await fetch('/api/daily-posts/clear', { method: 'POST' });
        logActivity('[Post] Đã dọn dẹp sạch toàn bộ hàng đợi bài đăng.');
        refreshData();
      }
    }

    // ========================================================
    // LOGIC TOPIC 3: QUÉT SÂU THÀNH VIÊN GROUP (MEMBER SCANNER)
    // ========================================================
    let currentScannedMembers = [];
    let activeMemberFilter = 'all';

    async function onSelectSavedGroup(url) {
      if (url) {
        document.getElementById('web-member-group-url').value = url;
      }
    }

    async function scanGroupMembersFromWeb(isReset = false) {
      const groupUrl = document.getElementById('web-member-group-url')?.value?.trim();
      if (!groupUrl) return alert('Vui lòng dán link Facebook Group cần quét!');

      const btn = document.getElementById('btn-scan-members');
      const icon = document.getElementById('scan-members-icon');
      const text = document.getElementById('scan-members-text');
      const progressBox = document.getElementById('scan-progress-box');

      btn.disabled = true;
      if (icon) icon.className = 'w-3.5 h-3.5 rounded-full border-2 border-white border-t-transparent animate-spin inline-block';
      if (text) text.textContent = 'ĐANG QUÉT SÂU 10 LẦN...';
      if (progressBox) progressBox.classList.remove('hidden');

      logActivity(`[MemberScan] Bắt đầu quét sâu thành viên Group: ${groupUrl}...`);

      try {
        const res = await fetch('/api/members/scan', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ groupUrl, resetBaseline: isReset })
        }).then(r => r.json());

        if (res.success) {
          currentScannedMembers = res.members || [];
          const newMembers = res.newMembers || [];
          const todayJoiners = currentScannedMembers.filter(m => /phút trước|giờ trước|vừa xong/i.test(m.name));

          document.getElementById('stat-scanned-total').textContent = currentScannedMembers.length;
          document.getElementById('stat-scanned-today').textContent = todayJoiners.length;
          document.getElementById('stat-scanned-new').textContent = res.baselineCreated ? `${currentScannedMembers.length} (Mốc mới)` : newMembers.length;

          document.getElementById('count-filter-all').textContent = currentScannedMembers.length;
          document.getElementById('count-filter-today').textContent = todayJoiners.length;
          document.getElementById('count-filter-other').textContent = currentScannedMembers.length - todayJoiners.length;

          renderScannedMembersTable();
          logActivity(`[MemberScan] Quét thành công! Tìm thấy ${currentScannedMembers.length} thành viên (${todayJoiners.length} thành viên gia nhập hôm nay).`);
          alert(`🎉 Quét thành công ${currentScannedMembers.length} thành viên trong Group!\n• ${todayJoiners.length} thành viên vừa gia nhập hôm nay.`);
        } else {
          alert('⚠️ Lỗi khi quét thành viên: ' + (res.error || 'Không tải được danh sách'));
        }
      } catch (err) {
        alert('❌ Lỗi kết nối: ' + err.message);
      } finally {
        btn.disabled = false;
        if (icon) icon.className = '';
        if (text) text.textContent = 'QUÉT SÂU THÀNH VIÊN';
        if (progressBox) progressBox.classList.add('hidden');
      }
    }

    async function resetMemberBaselineFromWeb() {
      if (confirm('Xác nhận đặt lại mốc tham chiếu thành viên? Lần quét tiếp theo sẽ coi toàn bộ thành viên là mốc ban đầu.')) {
        await fetch('/api/members/reset', { method: 'POST' });
        logActivity('[MemberScan] Đã reset mốc tham chiếu thành viên Group.');
        alert('🔄 Đã xóa mốc tham chiếu cũ thành công!');
        scanGroupMembersFromWeb(true);
      }
    }

    function filterScannedMembers(filter) {
      activeMemberFilter = filter;
      ['all', 'today', 'other'].forEach(f => {
        const btn = document.getElementById(`filter-btn-${f}`);
        if (btn) {
          if (f === filter) {
            btn.className = 'px-3 py-1.5 rounded-xl font-semibold transition bg-[#D96B43]/20 text-[#FAF7F2] border border-[#D96B43]/30';
          } else {
            btn.className = 'px-3 py-1.5 rounded-xl font-semibold transition text-[#A8A29E] hover:text-[#FAF7F2] hover:bg-[#24201C]';
          }
        }
      });
      renderScannedMembersTable();
    }

    function renderScannedMembersTable() {
      const tbody = document.getElementById('scanned-members-tbody');
      if (!tbody) return;

      let list = currentScannedMembers;
      if (activeMemberFilter === 'today') {
        list = currentScannedMembers.filter(m => /phút trước|giờ trước|vừa xong/i.test(m.name));
      } else if (activeMemberFilter === 'other') {
        list = currentScannedMembers.filter(m => !/phút trước|giờ trước|vừa xong/i.test(m.name));
      }

      if (list.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" class="py-10 text-center text-[#A8A29E] font-mono text-xs">Không có thành viên nào trong danh mục lọc này.</td></tr>';
        return;
      }

      tbody.innerHTML = list.map((m, idx) => {
        const isToday = /phút trước|giờ trước|vừa xong/i.test(m.name);
        return `
          <tr class="hover:bg-[#1A1613] transition font-sans">
            <td class="py-3 px-4 font-mono text-[#A8A29E] font-bold">${idx + 1}</td>
            <td class="py-3 px-4">
              <div class="flex items-center gap-2">
                ${isToday ? '<span class="text-xs">🔥</span>' : '<span class="text-xs">👤</span>'}
                <span class="font-bold text-[#FAF7F2]">${escapeHtml(m.name)}</span>
              </div>
            </td>
            <td class="py-3 px-4">
              <a href="${m.url}" target="_blank" rel="noopener noreferrer" class="font-mono text-[#F59E0B] hover:underline flex items-center gap-1">
                <span class="truncate max-w-xs">${escapeHtml(m.url)}</span>
                <span class="text-[10px]">↗</span>
              </a>
            </td>
            <td class="py-3 px-4 text-right">
              <div class="flex items-center justify-end gap-1.5">
                <a href="${m.url}" target="_blank" class="px-2.5 py-1 rounded-lg bg-[#24201C] hover:bg-[#2C2723] text-[#FAF7F2] border border-[#3E3832] text-[10px] font-semibold transition">
                  Mở Profile ↗
                </a>
                <button onclick="quickAddFriendFromWeb('${m.url}', this)" class="px-2.5 py-1 rounded-lg bg-[#F59E0B]/15 hover:bg-[#F59E0B]/25 text-[#F59E0B] border border-[#F59E0B]/30 text-[10px] font-bold transition">
                  ➕ Kết Bạn
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }

    function copyAllScannedMemberLinks() {
      if (currentScannedMembers.length === 0) return alert('Chưa có danh sách thành viên để sao chép!');
      const text = currentScannedMembers.map((m, i) => `${i + 1}. ${m.name}\n${m.url}`).join('\n\n');
      navigator.clipboard.writeText(text).then(() => {
        alert(`📋 Đã sao chép link của toàn bộ ${currentScannedMembers.length} thành viên vào bộ nhớ tạm!`);
      }).catch(() => {
        alert('Không thể truy cập Clipboard máy tính.');
      });
    }

    async function quickAddFriendFromWeb(profileUrl, btnEl) {
      if (!profileUrl) return;
      if (btnEl) {
        btnEl.disabled = true;
        btnEl.textContent = 'Đang gửi...';
      }
      try {
        const res = await fetch('/api/actions/friend', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ profileUrl })
        }).then(r => r.json());

        if (res.success) {
          alert(`✅ ${res.message}`);
          logActivity(`[Friend] Gửi kết bạn: ${res.message}`);
          if (btnEl) btnEl.textContent = '✅ Đã gửi';
        } else {
          alert(`⚠️ ${res.error || 'Không gửi được lời mời'}`);
          if (btnEl) {
            btnEl.disabled = false;
            btnEl.textContent = '➕ Kết Bạn';
          }
        }
      } catch (err) {
        alert('❌ Lỗi: ' + err.message);
        if (btnEl) {
          btnEl.disabled = false;
          btnEl.textContent = '➕ Kết Bạn';
        }
      }
    }

    async function sendTargetFriendFromWeb() {
      const profileUrl = document.getElementById('web-friend-profile-url')?.value?.trim();
      if (!profileUrl) return alert('Vui lòng dán link Profile Facebook cần kết bạn!');

      const btn = document.getElementById('btn-send-friend');
      const resultBox = document.getElementById('web-friend-result');
      btn.disabled = true;
      btn.textContent = 'Đang gửi lời mời kết bạn qua Facebook...';

      try {
        const res = await fetch('/api/actions/friend', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ profileUrl })
        }).then(r => r.json());

        resultBox.classList.remove('hidden');
        if (res.success) {
          resultBox.className = 'p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono';
          resultBox.textContent = `✅ ${res.message}`;
          logActivity(`[Topic 4] Gửi lời mời kết bạn thành công: ${profileUrl}`);
        } else {
          resultBox.className = 'p-3 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs font-mono';
          resultBox.textContent = `❌ ${res.error || 'Thất bại'}`;
        }
      } catch (err) {
        alert('❌ Lỗi: ' + err.message);
      } finally {
        btn.disabled = false;
        btn.textContent = '➕ Gửi Lời Mời Kết Bạn Ngay';
      }
    }

    async function sendTargetReactFromWeb() {
      const url = document.getElementById('web-react-url')?.value?.trim();
      if (!url) return alert('Vui lòng dán link bài viết hoặc Story!');

      const reaction = document.getElementById('web-react-type')?.value || 'like';
      const btn = document.getElementById('btn-send-react');
      const resultBox = document.getElementById('web-react-result');

      btn.disabled = true;
      btn.textContent = 'Đang thả cảm xúc...';

      try {
        const res = await fetch('/api/actions/react', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url, reaction })
        }).then(r => r.json());

        resultBox.classList.remove('hidden');
        if (res.success) {
          resultBox.className = 'p-3 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs font-mono';
          resultBox.textContent = `❤️ ${res.message}`;
          logActivity(`[Topic 5] Thả cảm xúc thành công: ${url}`);
        } else {
          resultBox.className = 'p-3 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-mono';
          resultBox.textContent = `❌ ${res.error || 'Thất bại'}`;
        }
      } catch (err) {
        alert('❌ Lỗi: ' + err.message);
      } finally {
        btn.disabled = false;
        btn.textContent = '⚡ Thả Cảm Xúc';
      }
    }

    async function populateSavedGroupsDropdown() {
      const select = document.getElementById('web-member-group-select');
      if (!select) return;
      try {
        const res = await fetch('/api/autocmt/data').then(r => r.json());
        const groups = res.groups || [];
        const currentVal = select.value;
        select.innerHTML = '<option value="">-- Chọn nhanh Group đã lưu --</option>' + groups.map(g => `
          <option value="${escapeHtml(g.url)}" ${g.url === currentVal ? 'selected' : ''}>👥 ${escapeHtml(g.name || g.url)}</option>
        `).join('');
      } catch {}
    }

    function renderAccountsList() {
      const container = document.getElementById('accounts-cards-container');
      if (!container || !summaryData) return;
      const accs = summaryData.accounts.items || [];

      container.innerHTML = accs.map(a => {
        let proxyBadge = '';
        if (a.proxy) {
          if (a.proxyStatus === 'live') {
            proxyBadge = '<span class="px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 text-[10px] font-mono font-bold flex items-center gap-1"><span>🛡️</span> AN TOÀN (2 LỚP)</span>';
          } else if (a.proxyStatus === 'dead') {
            proxyBadge = '<span class="px-2 py-0.5 rounded-full bg-rose-500/15 text-rose-400 border border-rose-500/30 text-[10px] font-mono font-bold flex items-center gap-1"><span>🚨</span> LỖI / CHẾT</span>';
          } else {
            proxyBadge = '<span class="px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-400 border border-amber-500/30 text-[10px] font-mono font-bold flex items-center gap-1"><span>⏳</span> CHƯA TEST</span>';
          }
        } else {
          proxyBadge = '<span class="px-2 py-0.5 rounded-full bg-stone-500/15 text-stone-400 border border-stone-500/30 text-[10px] font-mono font-medium">IP TRỰC TIẾP</span>';
        }

        return `
        <div class="claude-card rounded-3xl p-5 space-y-4 transition">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3.5">
              <div class="relative cursor-pointer group/cardavatar" onclick="openAvatarModal('${a.id}')" title="Nhấp để đổi avatar">
                <img src="${a.avatar || 'https://graph.facebook.com/' + a.uid + '/picture?type=large'}" class="w-12 h-12 rounded-2xl object-cover border border-[#3E3832] shadow group-hover/cardavatar:border-[#D96B43] transition" />
                <span class="absolute inset-0 bg-black/40 rounded-2xl opacity-0 group-hover/cardavatar:opacity-100 flex items-center justify-center text-[10px] text-white transition">📸</span>
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <button onclick="openProxiedBrowser('${a.id}', '${escapeHtml(a.name)}')" class="text-sm font-bold text-[#FAF7F2] hover:text-[#4599FF] transition flex items-center gap-1 text-left" title="Mở Facebook trực tiếp qua Proxy riêng an toàn">
                    <span>${escapeHtml(a.name)}</span>
                    <span class="text-xs text-[#4599FF]">↗</span>
                  </button>
                  ${a.isDefault ? '<span class="text-[9px] font-mono px-2 py-0.5 rounded-full bg-[#D96B43]/20 text-[#E87A5D] border border-[#D96B43]/30 font-bold">MẶC ĐỊNH</span>' : ''}
                </div>
                <span class="text-xs text-[#A8A29E] font-mono">UID: ${a.uid || a.id}</span>
              </div>
            </div>
            ${!a.isDefault ? `
              <button onclick="switchAccount('${a.id}')" class="text-xs bg-[#24201C] hover:bg-[#2C2723] text-[#FAF7F2] border border-[#3E3832] px-3 py-1.5 rounded-xl transition font-semibold">
                Chuyển sang nick này
              </button>
            ` : '<span class="text-emerald-400 text-xs font-mono font-bold flex items-center gap-1"><span>●</span> Đang hoạt động</span>'}
          </div>

          <div class="p-3.5 rounded-2xl bg-[#171412] border border-[#2E2925] text-xs font-mono text-[#D6D3D1] space-y-2">
            <div class="flex items-center justify-between flex-wrap gap-1">
              <span class="text-[#78716C]">Proxy Cấu Hình:</span>
              <div class="flex items-center gap-2">
                <span class="text-[#E87A5D] truncate max-w-[200px]">${a.proxy || 'Trực tiếp (Local IP)'}</span>
                ${proxyBadge}
              </div>
            </div>
            ${a.verifiedProxyIp ? `
              <div class="flex items-center justify-between flex-wrap gap-1">
                <span class="text-[#78716C]">IP Ngoại Mạng (Out):</span>
                <span class="text-emerald-400 font-bold">${a.verifiedProxyIp} ${a.proxyCountry ? `(${a.proxyCountry})` : ''} ${a.proxyLatencyMs ? `⚡ ${a.proxyLatencyMs}ms` : ''}</span>
              </div>
            ` : ''}
            <div class="flex items-center justify-between">
              <span class="text-[#78716C]">Hồ Sơ Cách Ly:</span>
              <span class="text-[#A8A29E] truncate max-w-[220px]">${a.profileDir || '.user-data'}</span>
            </div>
          </div>

          <!-- Action Buttons Bar for this Account -->
          <div class="flex items-center gap-2 pt-1 flex-wrap">
            <button onclick="testSingleAccountProxy('${a.id}')" id="btn-test-acc-${a.id}" class="py-1.5 px-3 rounded-xl bg-amber-500/15 hover:bg-amber-500/25 text-amber-400 border border-amber-500/30 text-xs font-bold flex items-center gap-1.5 transition">
              <span>⚡</span> Test Proxy 2 Lớp
            </button>
            <button onclick="openEditProxyModal('${a.id}', '${escapeHtml(a.proxy || '')}', '${escapeHtml(a.name)}')" class="py-1.5 px-3 rounded-xl bg-[#24201C] hover:bg-[#2C2723] text-[#FAF7F2] border border-[#3E3832] text-xs font-semibold flex items-center gap-1.5 transition">
              <span>✏️</span> Cấu Hình Proxy
            </button>
            <button onclick="openProxiedBrowser('${a.id}', '${escapeHtml(a.name)}')" 
               class="py-1.5 px-3 rounded-xl bg-[#1877F2]/15 hover:bg-[#1877F2]/25 text-[#4599FF] border border-[#1877F2]/30 text-xs font-bold flex items-center justify-center gap-1.5 transition"
               title="Mở cửa sổ Chrome độc lập bọc sẵn Proxy riêng của nick này (Tuyệt đối không lộ IP máy)">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              <span>Mở FB (Proxy) ↗</span>
            </button>
            <button onclick="openAvatarModal('${a.id}')" class="py-1.5 px-3 rounded-xl bg-[#24201C] hover:bg-[#2C2723] text-[#FAF7F2] border border-[#3E3832] text-xs font-semibold flex items-center gap-1.5 transition" title="Đổi hoặc đồng bộ ảnh đại diện">
              <span>📸</span> Avatar
            </button>
            ${a.isDefault ? `
              <button onclick="syncAvatarNow()" class="py-1.5 px-3 rounded-xl bg-[#D96B43]/15 hover:bg-[#D96B43]/25 text-[#E87A5D] border border-[#D96B43]/30 text-xs font-bold flex items-center gap-1 transition" title="Trích xuất trực tiếp từ trình duyệt">
                <span>🔄</span> Sync FB
              </button>
            ` : ''}
          </div>
        </div>
        `;
      }).join('');
    }

    function renderAutoCommentSection() {
      fetch('/api/autocmt/data').then(r => r.json()).then(data => {
        document.getElementById('monitored-groups-count').textContent = data.groups.length;
        document.getElementById('monitored-keywords-count').textContent = data.keywords.length;

        const groupsChipList = document.getElementById('groups-chip-list');
        if (data.groups.length === 0) {
          groupsChipList.innerHTML = '<span class="text-[#A8A29E] text-xs">Chưa có nhóm mục tiêu. Thêm bằng <code>+group &lt;link&gt;</code> trong Telegram!</span>';
        } else {
          groupsChipList.innerHTML = data.groups.map(g => `
            <a href="${g.url}" target="_blank" class="bg-[#171412] hover:bg-[#201D1A] border border-[#2E2925] text-[#D6D3D1] px-3 py-1.5 rounded-xl text-xs flex items-center gap-2 transition">
              <span>👥</span> <span class="truncate max-w-[150px] font-medium">${escapeHtml(g.name)}</span>
            </a>
          `).join('');
        }

        const keywordsChipList = document.getElementById('keywords-chip-list');
        if (data.keywords.length === 0) {
          keywordsChipList.innerHTML = '<span class="text-[#A8A29E] text-xs">Chưa có từ khóa. Thêm bằng <code>+tukhoa &lt;từ&gt;</code> trong Telegram!</span>';
        } else {
          keywordsChipList.innerHTML = data.keywords.map(k => `
            <span class="bg-[#D96B43]/10 border border-[#D96B43]/25 text-[#E87A5D] px-3 py-1 rounded-xl text-xs font-mono font-medium">
              #${escapeHtml(k)}
            </span>
          `).join('');
        }

        const logsTbody = document.getElementById('comment-logs-tbody');
        if (data.logs.length === 0) {
          logsTbody.innerHTML = '<tr><td colspan="5" class="py-10 text-center text-[#A8A29E] font-mono text-xs">Chưa có lịch sử bình luận nào được ghi nhận.</td></tr>';
        } else {
          logsTbody.innerHTML = data.logs.slice(0, 15).map(l => `
            <tr class="hover:bg-[#201D1A] font-mono">
              <td class="py-3 px-4 text-[#A8A29E]">${new Date(l.timestamp).toLocaleTimeString('vi-VN')}</td>
              <td class="py-3 px-4 text-[#E87A5D] font-semibold">${escapeHtml(l.accountName)}</td>
              <td class="py-3 px-4"><a href="${l.postUrl}" target="_blank" class="text-[#F59E0B] hover:underline">Link bài ↗</a></td>
              <td class="py-3 px-4 text-[#D6D3D1] max-w-xs truncate">${escapeHtml(l.commentText)}</td>
              <td class="py-3 px-4">
                ${l.status === 'success' 
                  ? '<span class="text-emerald-400 font-bold flex items-center gap-1"><span>✅</span> Đã xác minh</span>' 
                  : `<span class="text-rose-400 font-bold" title="${escapeHtml(l.error || '')}">❌ Thất bại</span>`}
              </td>
            </tr>
          `).join('');
        }
      }).catch(() => {});
    }

    async function toggleAutoComment() {
      if (!summaryData) return;
      const targetState = !(summaryData.autoComment && summaryData.autoComment.enabled);
      await fetch('/api/autocmt/config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ enabled: targetState })
      });
      logActivity(`[AutoComment] Đã ${targetState ? 'BẬT' : 'TẮT'} chế độ tự động quét nhóm.`);
      refreshData();
    }

    async function runPostNow(id) {
      logActivity(`[DailyPost] Bắt đầu kích hoạt xuất bản bài đăng #${id}...`);
      await fetch(`/api/daily-posts/${id}/run`, { method: 'POST' });
      refreshData();
    }

    async function switchAccount(accId) {
      if (confirm('Bạn có muốn chuyển phiên làm việc sang tài khoản Facebook này không?')) {
        logActivity(`[Account] Đang chuyển đổi phiên trình duyệt sang tài khoản: ${accId}`);
        await fetch(`/api/accounts/${accId}/select`, { method: 'POST' });
        refreshData();
      }
    }

    function logActivity(text) {
      const stream = document.getElementById('live-activity-stream');
      const terminal = document.getElementById('terminal-screen');
      const time = new Date().toLocaleTimeString('vi-VN');

      if (stream) {
        const row = document.createElement('div');
        row.className = 'p-2.5 rounded-xl bg-[#171412] border border-[#2E2925] text-[#D6D3D1]';
        row.innerHTML = `<span class="text-[#78716C]">[${time}]</span> ${escapeHtml(text)}`;
        stream.prepend(row);
        if (stream.children.length > 25) stream.removeChild(stream.lastChild);
      }

      if (terminal) {
        const tRow = document.createElement('div');
        tRow.innerHTML = `<span class="text-[#78716C]">[${time}]</span> <span class="text-[#FAF7F2]">${escapeHtml(text)}</span>`;
        terminal.appendChild(tRow);
        terminal.scrollTop = terminal.scrollHeight;
      }
    }

    function clearConsoleLog() {
      const term = document.getElementById('terminal-screen');
      if (term) term.innerHTML = '<div class="text-[#78716C]">[Console cleared]</div>';
    }

    function viewScreenModal() {
      document.getElementById('screen-img').src = '/api/screenshot?t=' + Date.now();
      document.getElementById('screen-modal').classList.remove('hidden');
    }
    function refreshScreenModal() {
      document.getElementById('screen-img').src = '/api/screenshot?t=' + Date.now();
    }
    function closeScreenModal() {
      document.getElementById('screen-modal').classList.add('hidden');
    }

    function openAddAccountModal() {
      document.getElementById('add-account-modal').classList.remove('hidden');
    }
    function closeAddAccountModal() {
      document.getElementById('add-account-modal').classList.add('hidden');
    }

    async function submitLoginCookie() {
      const name = document.getElementById('cookie-acc-name').value.trim();
      const cookie = document.getElementById('cookie-acc-input').value.trim();
      const proxy = document.getElementById('cookie-acc-proxy').value.trim();
      const makeDefault = document.getElementById('cookie-make-active').checked;

      if (!cookie) return alert('Vui lòng dán chuỗi Cookie Facebook vào ô!');

      const btn = document.getElementById('btn-submit-cookie');
      btn.disabled = true;
      btn.textContent = 'Đang xác thực Cookie & đăng nhập...';

      try {
        const res = await fetch('/api/accounts/login-cookie', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ cookie, name, proxy, makeDefault })
        }).then(r => r.json());

        if (res.success) {
          alert(`🎉 ${res.message}\nTài khoản đã được thêm vào hệ thống!`);
          closeAddAccountModal();
          logActivity(`[Account] Thêm tài khoản thành công: ${res.account.name}`);
          refreshData();
        } else {
          alert(`❌ Đăng nhập thất bại: ${res.error}`);
        }
      } catch (e) {
        alert(`❌ Lỗi: ${e.message}`);
      } finally {
        btn.disabled = false;
        btn.textContent = 'Xác Thực & Thêm Tài Khoản';
      }
    }

    async function openProxiedBrowser(accId, accName, targetUrl) {
      const acc = summaryData?.accounts?.items?.find(a => a.id === accId);
      const displayName = acc ? acc.name : (accName || 'Tài khoản');

      // 1. RÀNG BUỘC CẢNH BÁO NẾU NICK CHƯA GẮN PROXY
      if (acc && !acc.proxy) {
        const proceed = confirm(
          `⚠️ CẢNH BÁO BẢO VỆ TÀI KHOẢN:\n\n` +
          `Nick "${displayName}" CHƯA ĐƯỢC GẮN PROXY RIÊNG BIỆT!\n\n` +
          `Nếu bạn mở trình duyệt ngay bây giờ, Facebook sẽ ghi nhận địa chỉ IP MẠNG MÁY THẬT của bạn. Nếu bạn nuôi hoặc chạy nhiều nick, điều này rất dễ làm Facebook quét trùng IP và checkpoint cả dàn nick.\n\n` +
          `• Bấm [OK] nếu bạn vẫn chấp nhận mở bằng mạng máy trực tiếp.\n` +
          `• Bấm [Cancel] để dừng lại và gắn Proxy riêng cho nick trước.`
        );
        if (!proceed) return;
      }

      try {
        const btn = event?.currentTarget;
        if (btn) btn.classList.add('opacity-50');
        logActivity(`[Trình Duyệt] Đang yêu cầu khởi chạy trình duyệt an toàn cho nick "${displayName}"...`);

        const res = await fetch(`/api/accounts/${accId}/open-browser`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ targetUrl })
        }).then(r => r.json());

        if (btn) btn.classList.remove('opacity-50');

        if (res.success) {
          if (res.isDirect) {
            alert(`ℹ️ ĐÃ MỞ FACEBOOK (IP MÁY THẬT):\n\n${res.message}\n\nLưu ý: Nick này chưa gắn Proxy, đang chạy trên mạng nội bộ.`);
          } else {
            alert(
              `🛡️ ĐÃ MỞ FACEBOOK BỌC PROXY AN TOÀN 100%:\n\n` +
              `${res.message}\n\n` +
              `• Proxy bọc ngoài: ${res.proxy}\n` +
              `• Ràng buộc: BẮT BUỘC QUA PROXY BAN ĐẦU\n` +
              `• Chống rò rỉ WebRTC & DNS: 100% cách ly, tuyệt đối KHÔNG lộ IP máy thật của bạn!`
            );
          }
          logActivity(`[Trình Duyệt OK] Đã mở cửa sổ an toàn cho nick: ${displayName}`);
        } else {
          alert(`🚨 KHÔNG THỂ MỞ TRÌNH DUYỆT:\n\n${res.error}`);
          logActivity(`[Trình Duyệt Chặn] ${res.error}`);
        }
      } catch (err) {
        alert(`❌ Lỗi kết nối server: ${err.message}`);
      }
    }

    async function openSidebarActiveAccountBrowser() {
      const activeAcc = summaryData?.accounts?.items?.find(a => a.isDefault) || summaryData?.accounts?.items?.[0];
      if (!activeAcc) {
        alert('Chưa có tài khoản Facebook nào đang hoạt động.');
        return;
      }
      return openProxiedBrowser(activeAcc.id, activeAcc.name);
    }

    async function openSidebarActiveProfilePage() {
      const activeAcc = summaryData?.accounts?.items?.find(a => a.isDefault) || summaryData?.accounts?.items?.[0];
      if (!activeAcc) return;
      const targetUrl = `https://www.facebook.com/${activeAcc.uid || activeAcc.id}`;
      return openProxiedBrowser(activeAcc.id, activeAcc.name, targetUrl);
    }

    function checkSidebarProxyModal() {
      const activeAcc = summaryData?.accounts?.items?.find(a => a.isDefault) || summaryData?.accounts?.items?.[0];
      if (!activeAcc) {
        alert('Chưa có tài khoản Facebook nào đang hoạt động.');
        return;
      }
      inspectAccountProxy(activeAcc.id);
    }

    function closeProxyInspectModal() {
      const modal = document.getElementById('proxy-inspect-modal');
      if (modal) modal.classList.add('hidden');
    }

    async function inspectAccountProxy(accountId) {
      const modal = document.getElementById('proxy-inspect-modal');
      const content = document.getElementById('proxy-inspect-content');
      const footer = document.getElementById('proxy-inspect-footer');
      const badgeContainer = document.getElementById('proxy-inspect-bind-badge');
      if (!modal || !content) return;

      const acc = summaryData?.accounts?.items?.find(a => a.id === accountId) || { id: accountId, name: 'Eco Trang', uid: '61577949601039' };

      document.getElementById('proxy-inspect-accname').textContent = acc.name;
      document.getElementById('proxy-inspect-accuid').textContent = `UID: ${acc.uid || acc.id}`;
      document.getElementById('proxy-inspect-avatar').src = acc.avatar || `https://graph.facebook.com/${acc.uid || acc.id}/picture?type=large`;

      badgeContainer.innerHTML = '<span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-[#24201C] text-[#A8A29E] border border-[#3E3832]">⏳ Đang kiểm tra...</span>';
      
      content.innerHTML = `
        <div class="py-8 text-center space-y-3">
          <div class="w-10 h-10 border-2 border-amber-500/30 border-t-amber-500 rounded-full animate-spin mx-auto"></div>
          <div class="space-y-1">
            <p class="text-xs font-bold text-[#FAF7F2]">Đang kiểm tra đường hầm Proxy & đo đạc an toàn mạng...</p>
            <p class="text-[10px] text-[#A8A29E]">Xác minh IP ngoại mạng, đo ping và kiểm tra chống rò rỉ IP máy thật</p>
          </div>
        </div>
      `;

      footer.innerHTML = `
        <button onclick="closeProxyInspectModal()" class="w-full py-2.5 rounded-xl bg-[#24201C] hover:bg-[#2C2723] text-[#FAF7F2] border border-[#3E3832] font-semibold text-xs transition">
          Đóng
        </button>
      `;

      modal.classList.remove('hidden');

      try {
        const res = await fetch(`/api/accounts/${accountId}/test-proxy`, { method: 'POST' }).then(r => r.json());

        // TRƯỜNG HỢP 1: TÀI KHOẢN KHÔNG CÓ PROXY
        if (res.isDirect || !acc.proxy) {
          badgeContainer.innerHTML = '<span class="px-2.5 py-1 rounded-xl bg-amber-500/15 text-amber-300 border border-amber-500/30 text-[10px] font-mono font-bold">⚠️ CHƯA CÓ PROXY</span>';

          content.innerHTML = `
            <div class="p-4 rounded-2xl bg-amber-500/10 border border-amber-500/30 space-y-2">
              <div class="flex items-center gap-2.5">
                <span class="text-xl">⚠️</span>
                <div>
                  <h5 class="text-xs font-bold text-amber-300">TÀI KHOẢN NÀY KHÔNG CÓ PROXY RIÊNG BIỆT</h5>
                  <p class="text-[11px] text-amber-200/80">Hiện tại tài khoản đang chạy trực tiếp trên địa chỉ IP mạng nội bộ máy bạn.</p>
                </div>
              </div>
            </div>

            <div class="p-3.5 rounded-2xl bg-[#12100E] border border-[#2E2925] space-y-2.5 text-xs font-mono">
              <div class="flex items-center justify-between">
                <span class="text-[#78716C]">🖥️ IP Máy thật hiện tại:</span>
                <span class="text-amber-400 font-bold">${res.testResult?.ip || 'Chưa xác định'}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-[#78716C]">📍 Vị trí mạng máy:</span>
                <span class="text-[#D6D3D1]">${res.testResult?.country || 'Việt Nam'} ${res.testResult?.city ? `(${res.testResult.city})` : ''}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-[#78716C]">⚡ Độ trễ mạng:</span>
                <span class="text-[#D6D3D1]">${res.testResult?.latencyMs || 0} ms</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-[#78716C]">🔒 Ràng buộc bảo vệ:</span>
                <span class="text-amber-400 font-bold">Chưa bọc Proxy (Cảnh báo IP)</span>
              </div>
            </div>

            <div class="p-3 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-[11px] text-rose-300 space-y-1">
              <div class="font-bold flex items-center gap-1.5">
                <span>🚨</span> CẢNH BÁO NGUY CƠ CHECKPOINT:
              </div>
              <p class="text-[10px] text-rose-200/80 leading-relaxed">
                Nếu bạn vận hành hoặc đăng nhập nhiều nick Facebook trên cùng địa chỉ IP này, Facebook sẽ nhận diện chung thiết bị và quét checkpoint liên đới cả dàn nick.
              </p>
            </div>
