              <div class="flex items-center justify-between">
                <span class="text-[#78716C]">🔒 Ràng buộc mở Facebook:</span>
                <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-bold border border-emerald-500/30 text-[10px]">BẮT BUỘC QUA PROXY BAN ĐẦU</span>
              </div>
            </div>

            <div class="p-2.5 rounded-xl bg-[#141210] border border-[#2E2925] text-[10px] text-[#A8A29E] flex items-center gap-2">
              <span>🔒</span>
              <span>Ràng buộc nghiêm ngặt: Trình duyệt của nick này chỉ được mở khi Proxy này còn hoạt động. Nếu mất Proxy, hệ thống sẽ tự động khóa để bảo vệ nick.</span>
            </div>
          `;

          footer.innerHTML = `
            <button onclick="closeProxyInspectModal(); openProxiedBrowser('${acc.id}', '${escapeHtml(acc.name)}');" class="flex-1 py-2.5 rounded-xl bg-[#1877F2] hover:bg-[#166FE5] text-white font-bold text-xs transition shadow-md shadow-[#1877F2]/20 flex items-center justify-center gap-1.5">
              <span>🌐</span> Vào FB Qua Proxy Này ↗
            </button>
            <button onclick="inspectAccountProxy('${acc.id}')" class="py-2.5 px-3 rounded-xl bg-[#24201C] hover:bg-[#2C2723] text-[#FAF7F2] border border-[#3E3832] font-semibold text-xs transition" title="Kiểm tra lại kết nối">
              🔄 Test Lại
            </button>
            <button onclick="closeProxyInspectModal(); openEditProxyModal('${acc.id}', '${escapeHtml(acc.proxy || '')}', '${escapeHtml(acc.name)}');" class="py-2.5 px-3 rounded-xl bg-[#24201C] hover:bg-[#2C2723] text-[#FAF7F2] border border-[#3E3832] font-semibold text-xs transition" title="Đổi proxy">
              ✏️ Đổi
            </button>
            <button onclick="closeProxyInspectModal()" class="py-2.5 px-3 rounded-xl bg-[#24201C] hover:bg-[#2C2723] text-[#FAF7F2] border border-[#3E3832] font-semibold text-xs transition">
              Đóng
