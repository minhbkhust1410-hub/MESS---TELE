          </button>
          <button onclick="closeProxyInspectModal(); openEditProxyModal('${acc.id}', '${escapeHtml(acc.proxy || '')}', '${escapeHtml(acc.name)}');" class="flex-1 py-2.5 rounded-xl bg-[#D96B43] hover:bg-[#E27D56] text-white font-bold text-xs transition shadow-md shadow-[#D96B43]/20 flex items-center justify-center gap-1.5">
            <span>✏️</span> Cập Nhật Proxy Mới
