      } catch (err) {
        content.innerHTML = `
          <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-xs text-rose-300">
            ❌ Không thể kết nối tới máy chủ để kiểm tra Proxy: ${err.message}
