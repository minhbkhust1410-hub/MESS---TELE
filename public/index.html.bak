    let targetModalAccountId = null;
    let manualAvatarDataUrl = null;

    function openAvatarModal(accountId) {
      const active = (summaryData && summaryData.accounts && summaryData.accounts.items) 
        ? (accountId ? summaryData.accounts.items.find(a => a.id === accountId) : summaryData.accounts.items.find(a => a.isDefault))
        : null;

      targetModalAccountId = active ? active.id : (accountId || 'acc_61577949601039');
      if (active) {
        document.getElementById('avatar-modal-name').textContent = active.name;
        document.getElementById('avatar-modal-uid').textContent = `UID: ${active.uid || active.id}`;
        document.getElementById('avatar-modal-preview').src = active.avatar || `https://graph.facebook.com/${active.uid}/picture?type=large`;
      }
      document.getElementById('avatar-url-input').value = '';
      document.getElementById('avatar-file-input').value = '';
      manualAvatarDataUrl = null;
      document.getElementById('avatar-modal').classList.remove('hidden');
    }

    function closeAvatarModal() {
      document.getElementById('avatar-modal').classList.add('hidden');
    }

    async function syncAvatarNow(event) {
      if (event) event.stopPropagation();
      logActivity('[Avatar] Đang bắt đầu trích xuất ảnh đại diện thật từ Facebook...');
      try {
        const res = await fetch('/api/accounts/sync-avatar', { method: 'POST' }).then(r => r.json());
        if (res.success && res.avatarUrl) {
          logActivity(`[Avatar] Đồng bộ thành công! Đã lưu ảnh đại diện mới.`);
          document.getElementById('sidebar-avatar').src = res.avatarUrl;
          if (document.getElementById('avatar-modal-preview')) {
            document.getElementById('avatar-modal-preview').src = res.avatarUrl;
          }
          refreshData();
          alert('🎉 Đồng bộ ảnh đại diện Facebook thành công!');
        } else {
          alert(`⚠️ ${res.error || 'Chưa tìm thấy ảnh đại diện trong phiên hiện tại'}`);
        }
      } catch (err) {
        alert('❌ Lỗi khi đồng bộ avatar: ' + err.message);
      }
    }

    async function syncAvatarFromModal() {
      const btn = document.getElementById('btn-modal-sync-avatar');
      const icon = document.getElementById('sync-avatar-icon');
      btn.disabled = true;
      if (icon) icon.classList.add('animate-spin');
      try {
        await syncAvatarNow();
        closeAvatarModal();
      } finally {
        btn.disabled = false;
        if (icon) icon.classList.remove('animate-spin');
      }
    }

    function handleAvatarFileSelect(event) {
      const file = event.target.files[0];
      if (!file) return;
      if (!file.type.startsWith('image/')) {
        return alert('Vui lòng chọn một tệp hình ảnh hợp lệ (JPG, PNG, WebP)!');
      }
      const reader = new FileReader();
      reader.onload = (e) => {
        manualAvatarDataUrl = e.target.result;
        document.getElementById('avatar-modal-preview').src = manualAvatarDataUrl;
      };
      reader.readAsDataURL(file);
    }

    async function saveManualAvatar() {
      const urlInput = document.getElementById('avatar-url-input').value.trim();
      const finalAvatar = manualAvatarDataUrl || urlInput;
      if (!finalAvatar) {
        return alert('Vui lòng dán link ảnh hoặc chọn tệp ảnh từ máy tính!');
      }

      const accId = targetModalAccountId || (summaryData?.accounts?.items?.find(a => a.isDefault)?.id) || 'acc_61577949601039';
      const btn = document.getElementById('btn-save-manual-avatar');
      btn.disabled = true;
      btn.textContent = 'Đang lưu ảnh đại diện...';

      try {
        const res = await fetch('/api/accounts/update-avatar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ accountId: accId, avatarUrl: finalAvatar })
        }).then(r => r.json());

        if (res.success) {
          logActivity(`[Avatar] Đã cập nhật ảnh đại diện cho tài khoản: ${res.account.name}`);
          document.getElementById('sidebar-avatar').src = res.account.avatar;
          closeAvatarModal();
          refreshData();
          alert('🎉 Cập nhật ảnh đại diện thành công!');
        } else {
          alert('❌ Lưu avatar thất bại: ' + (res.error || 'Lỗi không xác định'));
        }
      } catch (err) {
        alert('❌ Lỗi kết nối: ' + err.message);
      } finally {
        btn.disabled = false;
        btn.textContent = '💾 Lưu Ảnh Đại Diện Này';
      }
    }

    async function resumeLoginFromModal() {
      logActivity('[Browser] Đang gửi lệnh nhấp chọn tài khoản Eco Trang...');
      const res = await fetch('/api/accounts/resume-login', { method: 'POST' }).then(r => r.json());
      if (res.clicked) {
        logActivity('[Browser] Đã nhấp chọn Eco Trang thành công!');
        setTimeout(refreshScreenModal, 2000);
      } else {
        alert('Trang không ở màn hình chọn tài khoản hoặc đã tự động đăng nhập.');
      }
    }

    // ==========================================
    // QUẢN LÝ & TEST PROXY ĐỘC LẬP TỪ WEB DASHBOARD
    // ==========================================
    let currentProxyModalAccountId = null;

    function openEditProxyModal(accountId, currentProxy, accountName) {
      currentProxyModalAccountId = accountId;
      document.getElementById('proxy-modal-accname').textContent = accountName || accountId;
      document.getElementById('proxy-modal-input').value = currentProxy || '';
      const testBox = document.getElementById('proxy-modal-test-box');
      testBox.classList.add('hidden');
      testBox.innerHTML = '';
      document.getElementById('proxy-modal').classList.remove('hidden');
    }

    function closeProxyModal() {
      document.getElementById('proxy-modal').classList.add('hidden');
    }

    async function testProxyInConfigModal() {
      const proxy = document.getElementById('proxy-modal-input').value.trim();
      const testBox = document.getElementById('proxy-modal-test-box');
      const btn = document.getElementById('btn-modal-test-proxy');

      if (!proxy) {
        testBox.className = 'p-3 rounded-xl bg-stone-900 border border-stone-700 text-stone-300 font-mono text-[11px] block';
        testBox.innerHTML = 'ℹ️ Không có Proxy: Tài khoản sẽ kết nối trực tiếp bằng IP máy thật.';
        return;
      }

      btn.disabled = true;
      btn.innerHTML = '<span>⏳</span> Đang test kết nối...';
      testBox.className = 'p-3 rounded-xl bg-[#1A1816] border border-[#3E3832] text-[#A8A29E] font-mono text-[11px] block';
      testBox.innerHTML = '🌐 Đang gửi yêu cầu đo độ trễ & dò IP ngoại mạng...';

      try {
        const res = await fetch('/api/accounts/test-proxy', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ proxy })
        }).then(r => r.json());

        if (res.success && res.alive) {
          if (res.isLeakingHostIp) {
            testBox.className = 'p-3 rounded-xl bg-rose-950/40 border border-rose-800 text-rose-300 font-mono text-[11px] block';
            testBox.innerHTML = `🚨 <b>RÒ RỈ IP PHÁT HIỆN!</b><br>Proxy trả về IP: <code>${res.ip}</code> trùng với IP máy thật.<br>Tuyệt đối không sử dụng proxy này!`;
          } else {
            testBox.className = 'p-3 rounded-xl bg-emerald-950/40 border border-emerald-800 text-emerald-300 font-mono text-[11px] block';
            testBox.innerHTML = `✅ <b>PROXY HOẠT ĐỘNG TỐT (AN TOÀN)!</b><br>• IP Ngoại Mạng: <code>${res.ip}</code><br>• Vị trí: 🌍 ${res.country || 'N/A'} (${res.city || ''})<br>• Nhà mạng: ${res.isp || 'N/A'}<br>• Độ trễ: ⚡ ${res.latencyMs}ms<br>• Rò rỉ IP: 🟢 Không rò rỉ (Độc lập 100%)`;
          }
        } else {
          testBox.className = 'p-3 rounded-xl bg-rose-950/40 border border-rose-800 text-rose-300 font-mono text-[11px] block';
          testBox.innerHTML = `❌ <b>KẾT NỐI PROXY THẤT BẠI!</b><br>Lỗi: ${res.error || 'Timeout không phản hồi'}`;
        }
      } catch (err) {
        testBox.className = 'p-3 rounded-xl bg-rose-950/40 border border-rose-800 text-rose-300 font-mono text-[11px] block';
        testBox.innerHTML = `❌ Lỗi gửi yêu cầu: ${err.message}`;
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<span>⚡</span> Test Proxy Ngay';
      }
    }

    async function saveProxyFromModal() {
      if (!currentProxyModalAccountId) return;
      const proxy = document.getElementById('proxy-modal-input').value.trim();
      const btn = document.getElementById('btn-modal-save-proxy');
      btn.disabled = true;
      btn.textContent = 'Đang lưu...';

      try {
        const res = await fetch(`/api/accounts/${currentProxyModalAccountId}/proxy`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ proxy })
        }).then(r => r.json());

        if (res.success) {
          alert(`🎉 ${res.message}`);
          closeProxyModal();
          logActivity(`[Proxy] Đã cập nhật proxy cho nick ${res.account.name}: ${proxy || 'Trực tiếp'}`);
          refreshData();
        } else {
          alert(`❌ Không thể lưu Proxy: ${res.error}`);
        }
      } catch (err) {
        alert(`❌ Lỗi: ${err.message}`);
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<span>💾</span> Lưu Proxy';
      }
    }

    async function testSingleAccountProxy(accountId) {
      inspectAccountProxy(accountId);
    }

    async function testProxyInModal(inputId, resultBoxId) {
      const val = document.getElementById(inputId).value.trim();
      const box = document.getElementById(resultBoxId);
      if (!val) {
        box.classList.remove('hidden');
        box.className = 'text-[10px] mt-1.5 font-mono p-2 rounded-xl bg-stone-900 border border-stone-700 text-stone-300 block';
        box.textContent = 'ℹ️ Vui lòng nhập địa chỉ Proxy trước khi test!';
        return;
      }

      box.classList.remove('hidden');
      box.className = 'text-[10px] mt-1.5 font-mono p-2 rounded-xl bg-[#1A1816] border border-[#3E3832] text-[#A8A29E] block';
      box.textContent = '⏳ Đang kiểm tra kết nối Proxy...';

      try {
        const res = await fetch('/api/accounts/test-proxy', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ proxy: val })
        }).then(r => r.json());

        if (res.success && res.alive) {
          if (res.isLeakingHostIp) {
            box.className = 'text-[10px] mt-1.5 font-mono p-2 rounded-xl bg-rose-950/40 border border-rose-800 text-rose-300 block';
            box.innerHTML = `🚨 RÒ RỈ IP: Trùng IP máy thật (${res.ip})!`;
          } else {
            box.className = 'text-[10px] mt-1.5 font-mono p-2 rounded-xl bg-emerald-950/40 border border-emerald-800 text-emerald-300 block';
            box.innerHTML = `✅ PROXY SỐNG: IP <b>${res.ip}</b> (${res.country}, ⚡${res.latencyMs}ms)`;
          }
        } else {
          box.className = 'text-[10px] mt-1.5 font-mono p-2 rounded-xl bg-rose-950/40 border border-rose-800 text-rose-300 block';
          box.textContent = `❌ Lỗi: ${res.error || 'Timeout'}`;
        }
      } catch (err) {
        box.className = 'text-[10px] mt-1.5 font-mono p-2 rounded-xl bg-rose-950/40 border border-rose-800 text-rose-300 block';
        box.textContent = '❌ Lỗi kết nối: ' + err.message;
      }
    }

    // ========================================================
    // CUTE GITHUB-STYLE CONFETTI & MASCOT INTERACTION ENGINE
    // ========================================================
    const cutePhrases = [
      "FalconX bọc Proxy kín 100% nha Boss! 🚀✨",
      "Động cơ FalconX đang bay êm ru 24/7! 🛰️💖",
      "Proxy Falcon Shield cách ly tuyệt đối, không lộ IP! 🛡️⚡",
      "Bể Lead FalconX đang gom Data tẹt ga luôn! 🌟🐟",
      "Auto-Bypass PIN sẵn sàng 24/24! 🔐✨",
      "Falcon Wing mở khóa sức mạnh cho Boss! 🚀🎉",
      "Tốc độ phản hồi cực nhanh chuẩn FalconX! ⚡🐾",
    ];
    let phraseIndex = 0;

    function onMascotClick(event) {
      const figure = document.getElementById('kudo-cat-figure');
      const textEl = document.getElementById('kudo-speech-text');
      const bubble = document.getElementById('kudo-speech-bubble');

      // Trigger happy bounce animation
      if (figure) {
        figure.classList.remove('animate-mascot-happy');
        void figure.offsetWidth; // re-flow
        figure.classList.add('animate-mascot-happy');
      }

      // Show speech bubble if hidden
      if (bubble && bubble.classList.contains('hidden')) {
        bubble.classList.remove('hidden');
      }

      // Rotate cute phrases
      phraseIndex = (phraseIndex + 1) % cutePhrases.length;
      if (textEl) {
        textEl.innerHTML = `<span>🐾</span> <span>${cutePhrases[phraseIndex]}</span>`;
      }

      // Launch cute confetti from mascot position
      const rect = figure.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      triggerCuteConfetti({ clientX: x, clientY: y });
    }

    function toggleMascotBubble(event) {
      if (event) event.stopPropagation();
      const bubble = document.getElementById('kudo-speech-bubble');
      if (bubble) bubble.classList.toggle('hidden');
    }

    // Pure Canvas Confetti
    let confettiParticles = [];
    let confettiAnimationId = null;

    function triggerCuteConfetti(event) {
      const canvas = document.getElementById('cute-confetti-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;

      const originX = event?.clientX || (window.innerWidth / 2);
      const originY = event?.clientY || (window.innerHeight / 2);

      const colors = ['#D96B43', '#E87A5D', '#F59E0B', '#10B981', '#8B5CF6', '#EC4899', '#FAF7F2'];
      const shapes = ['circle', 'square', 'heart'];

      for (let i = 0; i < 42; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = 3 + Math.random() * 8;
        confettiParticles.push({
          x: originX,
          y: originY,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed - 2.5,
          color: colors[Math.floor(Math.random() * colors.length)],
          size: 4 + Math.random() * 6,
          shape: shapes[Math.floor(Math.random() * shapes.length)],
          rotation: Math.random() * 360,
          vRot: (Math.random() - 0.5) * 12,
          gravity: 0.18 + Math.random() * 0.1,
          alpha: 1,
          decay: 0.015 + Math.random() * 0.015,
        });
      }

      if (!confettiAnimationId) {
        animateConfetti(canvas, ctx);
      }
    }

    function animateConfetti(canvas, ctx) {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      for (let i = confettiParticles.length - 1; i >= 0; i--) {
        const p = confettiParticles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.vy += p.gravity;
        p.rotation += p.vRot;
        p.alpha -= p.decay;

        if (p.alpha <= 0 || p.y > canvas.height + 50) {
          confettiParticles.splice(i, 1);
          continue;
        }

        ctx.save();
        ctx.globalAlpha = Math.max(0, p.alpha);
        ctx.translate(p.x, p.y);
        ctx.rotate((p.rotation * Math.PI) / 180);
        ctx.fillStyle = p.color;

        if (p.shape === 'circle') {
          ctx.beginPath();
          ctx.arc(0, 0, p.size / 2, 0, Math.PI * 2);
          ctx.fill();
        } else if (p.shape === 'heart') {
          ctx.beginPath();
          const d = p.size;
          ctx.moveTo(0, d / 4);
          ctx.bezierCurveTo(-d / 2, -d / 2, -d, d / 3, 0, d);
          ctx.bezierCurveTo(d, d / 3, d / 2, -d / 2, 0, d / 4);
          ctx.fill();
        } else {
          ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
        }

        ctx.restore();
      }

      if (confettiParticles.length > 0) {
        confettiAnimationId = requestAnimationFrame(() => animateConfetti(canvas, ctx));
      } else {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        confettiAnimationId = null;
      }
    }

    // Auto rotate speech bubble occasionally
    setInterval(() => {
      const textEl = document.getElementById('kudo-speech-text');
      if (textEl && Math.random() < 0.45) {
        phraseIndex = (phraseIndex + 1) % cutePhrases.length;
        textEl.innerHTML = `<span>🐾</span> <span>${cutePhrases[phraseIndex]}</span>`;
      }
    }, 15000);

    window.addEventListener('DOMContentLoaded', () => {
      refreshData();
      setInterval(refreshData, 5000);
    });
  </script>

  <!-- ======================================================== -->
  <!-- CUTE GITHUB-INSPIRED CYBER-CAT MASCOT ("KUDO-CAT")       -->
  <!-- ======================================================== -->
  <div id="kudo-cat-mascot-root" class="fixed bottom-5 right-6 z-40 select-none">
    
    <!-- Floating Cute Speech Bubble -->
    <div id="kudo-speech-bubble" class="mb-2.5 p-3 rounded-2xl bg-[#171412]/95 border border-[#D96B43]/40 shadow-2xl backdrop-blur-md max-w-[210px] text-[11px] text-[#FAF7F2] font-semibold leading-relaxed relative animate-in fade-in slide-in-from-bottom-2 duration-200 transition-all">
      <div id="kudo-speech-text" class="flex items-center gap-1.5">
        <span>🐾</span>
        <span>FalconX bọc Proxy kín 100% nha Boss! 🚀✨</span>
      </div>
      <!-- Speech bubble pointer -->
      <div class="absolute -bottom-1.5 right-8 w-3 h-3 bg-[#171412] border-r border-b border-[#D96B43]/40 transform rotate-45"></div>
      
      <!-- Close small button -->
      <button onclick="toggleMascotBubble(event)" class="absolute -top-1.5 -right-1.5 w-4 h-4 rounded-full bg-[#2C2723] hover:bg-[#3E3832] text-[#A8A29E] hover:text-white text-[9px] flex items-center justify-center border border-[#44403C] transition" title="Ẩn lời nhắn">✕</button>
    </div>

    <!-- Interactive Mascot Character -->
    <div class="flex items-center justify-end">
      <div id="kudo-cat-figure" onclick="onMascotClick(event)" class="mascot-container cursor-pointer group relative flex items-center justify-center hover:scale-110 active:scale-95 transition-all duration-200" title="Nhấp vào em để nhận niềm vui & bắn pháo hoa nè! 🐾">
        
        <!-- Floating sparkle icons -->
        <span class="mascot-sparkle absolute -top-1 -left-1 text-xs select-none">✨</span>
        <span class="mascot-sparkle absolute -top-2 right-1 text-xs select-none" style="animation-delay: 1.2s">💖</span>

        <!-- SVG Cat Character -->
        <svg class="w-14 h-14 drop-shadow-[0_8px_20px_rgba(217,107,67,0.35)]" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Left Ear -->
          <polygon class="ear-left" points="24,42 14,14 40,26" fill="#1C1816" stroke="#D96B43" stroke-width="2.5" stroke-linejoin="round"/>
          <polygon points="25,38 18,19 36,27" fill="#E87A5D" opacity="0.85"/>
          
          <!-- Right Ear -->
          <polygon class="ear-right" points="76,42 86,14 60,26" fill="#1C1816" stroke="#D96B43" stroke-width="2.5" stroke-linejoin="round"/>
          <polygon points="75,38 82,19 64,27" fill="#E87A5D" opacity="0.85"/>

          <!-- Head Base -->
          <circle cx="50" cy="52" r="34" fill="#1C1816" stroke="#44403C" stroke-width="2.5"/>
          
          <!-- Glowing Cyber Cheeks -->
          <circle cx="32" cy="58" r="4.5" fill="#E87A5D" opacity="0.65"/>
          <circle cx="68" cy="58" r="4.5" fill="#E87A5D" opacity="0.65"/>

          <!-- Expressive Eyes with Blink Animation -->
          <g class="mascot-eye">
            <ellipse cx="36" cy="48" rx="5" ry="6.5" fill="#FAF7F2"/>
            <ellipse cx="36" cy="48" rx="3.5" ry="5.5" fill="#141210"/>
            <circle cx="38" cy="46" r="1.8" fill="#FAF7F2"/>
            <circle cx="34.5" cy="50.5" r="0.9" fill="#FAF7F2"/>
          </g>
          <g class="mascot-eye">
            <ellipse cx="64" cy="48" rx="5" ry="6.5" fill="#FAF7F2"/>
            <ellipse cx="64" cy="48" rx="3.5" ry="5.5" fill="#141210"/>
            <circle cx="66" cy="46" r="1.8" fill="#FAF7F2"/>
            <circle cx="62.5" cy="50.5" r="0.9" fill="#FAF7F2"/>
          </g>

          <!-- Cute Nose & Mouth -->
          <polygon points="50,54 48,52 52,52" fill="#E87A5D"/>
          <path d="M 45 56 Q 50 60 50 56 Q 50 60 55 56" stroke="#FAF7F2" stroke-width="1.8" stroke-linecap="round" fill="none"/>

          <!-- Cyber Collar with Glowing Emerald Shield -->
          <rect x="36" y="80" width="28" height="6" rx="3" fill="#2E2925" stroke="#44403C"/>
          <circle cx="50" cy="83" r="3.5" fill="#10B981"/>
        </svg>

        <!-- Cute paw badge pill -->
        <div class="absolute -bottom-1 -right-1 px-1.5 py-0.5 rounded-full bg-[#D96B43] text-white text-[9px] font-bold shadow flex items-center gap-0.5 border border-[#1C1816]">
          <span>🐾</span>
        </div>
      </div>
    </div>
  </div>

</body>
</html>
