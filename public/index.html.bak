          <div class="claude-card rounded-2xl p-5 border-l-4 border-l-stone-400 transition">
            <div class="flex items-center justify-between text-xs text-[#A8A29E] mb-1.5">
              <span class="font-semibold uppercase tracking-wider text-[11px]">Đăng Bài & Phân Phối</span>
              <span class="text-stone-300 text-lg">📝</span>
            </div>
            <div class="flex items-baseline gap-2">
              <span id="kpi-posts-count" class="text-3xl font-black text-[#FAF7F2]">0</span>
