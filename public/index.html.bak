            </div>
            <div class="text-[11px] text-stone-300 mt-2 font-mono">
              Topic 1 · Khóa nguyên tử chống đăng lặp
            </div>
          </div>

          <div class="claude-card rounded-2xl p-5 border-l-4 border-l-emerald-600 transition">
            <div class="flex items-center justify-between text-xs text-[#A8A29E] mb-1.5">
